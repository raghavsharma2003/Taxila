   "text": {
    "L1": "ओणम केरल का बड़ा त्योहार है, जो अगस्त-सितंबर में मनाया जाता है।",
    "L2": "ओणम केवल फूलों की सजावट नहीं है। यह फ़सल की खुशी और राजा महाबली के स्वागत का त्योहार है।",
    "L3": "आँगन में फूलों से पूकलम बनता है, नावों की दौड़ होती है और केले के पत्ते पर ओणसद्या भोज परोसा जाता है।",
    "L4": "इन परंपराओं को याद रखो: पूकलम, नावों की दौड़ और ओणसद्या।",
    "L5": "‘प्रजा’ में प् और र जुड़े हैं, इसलिए इसे ‘परजा’ नहीं, प्रजा पढ़ते हैं।",
    "L6": "‘त्योहार’ को त् और यो जोड़कर त्यो, फिर हा और र पढ़ो: त्यो-हा-र।",
    "L7": "अब बताओ, ओणम किस राज्य का त्योहार है?"
   },
