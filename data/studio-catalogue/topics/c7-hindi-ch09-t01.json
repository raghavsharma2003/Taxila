   "text": {
    "L1": "कविता की चिड़िया छोटी है, फिर भी फुर्तीली, व्यस्त और प्रसन्न है।",
    "L2": "वह दाना चुगती, चहचहाती, फुदकती और खुले आकाश में उड़ती है।",
    "L3": "वह चोंच में बूँद-भर पानी लाती है और तिनके चुनकर अपना छोटा-सा घर बनाती है।",
    "L4": "उसका गाना और उड़ना मन में स्नेह, आनंद और आश्चर्य जगाता है।",
    "L5": "याद रखो, चिड़िया के लिए खुशी केवल दाने या सुरक्षा में नहीं है।",
    "L6": "पिंजरा सुंदर हो, फिर भी उड़ने की आज़ादी न हो तो चिड़िया उदास होगी।",
    "L7": "शब्द लिखते समय ध्यान दो: चिड़िया, पेड़ और उड़ना में बिंदु वाला ड़ आता है।",
    "L8": "एक चिड़िया, कई चिड़ियाँ; ‘को’ के साथ लिखेंगे—मैंने चिड़ियों को दाना डाला।",
    "L9": "अब बताओ, चिड़िया की खुशी का सबसे ज़रूरी आधार क्या है?"
   },
   "narration": {
    "L1": {
     "text": "कविता की चिड़िया छोटी है, फिर भी फुर्तीली, व्यस्त और प्रसन्न है।",
     "dur": 3.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "वह दाना चुगती, चहचहाती, फुदकती और खुले आकाश में उड़ती है।",
     "dur": 3.4,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "वह चोंच में बूँद-भर पानी लाती है और तिनके चुनकर अपना छोटा-सा घर बनाती है।",
     "dur": 4.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "उसका गाना और उड़ना मन में स्नेह, आनंद और आश्चर्य जगाता है।",
     "dur": 3.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "याद रखो, चिड़िया के लिए खुशी केवल दाने या सुरक्षा में नहीं है।",
     "dur": 3.3,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "पिंजरा सुंदर हो, फिर भी उड़ने की आज़ादी न हो तो चिड़िया उदास होगी।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L7": {
     "text": "शब्द लिखते समय ध्यान दो: चिड़िया, पेड़ और उड़ना में बिंदु वाला ड़ आता है।",
     "dur": 4.3,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L8": {
     "text": "एक चिड़िया, कई चिड़ियाँ; ‘को’ के साथ लिखेंगे—मैंने चिड़ियों को दाना डाला।",
