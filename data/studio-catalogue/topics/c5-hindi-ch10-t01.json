   "text": {
    "L1": "एक तालाब में सोचू, चटपट और सुस्ती नाम की तीन मछलियाँ रहती थीं।",
    "L2": "मछुआरों ने कहा, “कल सुबह यहाँ जाल डालेंगे।” अब तीनों को खतरा पता था।",
    "L3": "सोचू ने पहले ही योजना बनाई और उसी रात नाले से होकर नदी में चली गई।",
    "L4": "चटपट ने खतरा आने पर तुरंत दिमाग़ लगाया। वह मरने का नाटक करके जाल से बाहर निकल गई।",
    "L5": "मिथक है कि सुस्ती बहादुर थी। नहीं, खतरा जानकर भी कुछ न करना बहादुरी नहीं, लापरवाही थी।",
    "L6": "सोचू ने पहले तैयारी की और चटपट ने मुसीबत में उपाय किया। सुस्ती हाथ पर हाथ धरे बैठी रही और फँस गई।",
    "L7": "सीख है: समय पर तैयारी करो और मुसीबत में दिमाग़ से काम लो। परीक्षा में भी अभी से रोज़ थोड़ा पढ़ो।",
    "L8": "अब घटनाओं को कहानी के सही क्रम में लगाकर दिखाओ।"
   },
   "narration": {
    "L1": {
     "text": "एक तालाब में सोचू, चटपट और सुस्ती नाम की तीन मछलियाँ रहती थीं।",
     "dur": 4.2,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L2": {
     "text": "मछुआरों ने कहा, “कल सुबह यहाँ जाल डालेंगे।” अब तीनों को खतरा पता था।",
     "dur": 5.2,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L3": {
     "text": "सोचू ने पहले ही योजना बनाई और उसी रात नाले से होकर नदी में चली गई।",
     "dur": 5.4,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L4": {
     "text": "चटपट ने खतरा आने पर तुरंत दिमाग़ लगाया। वह मरने का नाटक करके जाल से बाहर निकल गई।",
     "dur": 6.2,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L5": {
     "text": "मिथक है कि सुस्ती बहादुर थी। नहीं, खतरा जानकर भी कुछ न करना बहादुरी नहीं, लापरवाही थी।",
     "dur": 6.2,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L6": {
     "text": "सोचू ने पहले तैयारी की और चटपट ने मुसीबत में उपाय किया। सुस्ती हाथ पर हाथ धरे बैठी रही और फँस गई।",
     "dur": 6.5,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L7": {
     "text": "सीख है: समय पर तैयारी करो और मुसीबत में दिमाग़ से काम लो। परीक्षा में भी अभी से रोज़ थोड़ा पढ़ो।",
     "dur": 6.4,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    },
    "L8": {
     "text": "अब घटनाओं को कहानी के सही क्रम में लगाकर दिखाओ।",
     "dur": 3.2,
     "lead": 0.2,
     "tail": 0.2,
     "pauses": []
    }
   },
