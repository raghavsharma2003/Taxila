   "text": {
    "L1": "फूल और काँटा एक ही पौधे पर उगते हैं।",
    "L2": "उन्हें एक जैसी धूप, हवा और बारिश मिलती है।",
    "L3": "फिर भी फूल सुगंध देकर सबको खुशी देता है, जबकि काँटा चुभकर दुख देता है।",
    "L4": "इसलिए केवल एक ही जगह या कुल में जन्म लेना किसी को अच्छा नहीं बनाता।",
    "L5": "मनुष्य जन्म से नहीं, अच्छे कर्मों से बड़ा बनता है।",
    "L6": "जो मदद करता है, वह फूल जैसा गुण दिखाता है; जो दुख देता है, वह काँटे जैसा लगता है।",
    "L7": "याद रखो, सुगंध का विलोम दुर्गंध और कोमल का विलोम कठोर है।",
    "L8": "अब बताओ, आदर पाने का सही आधार क्या है?"
   },
