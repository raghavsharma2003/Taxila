   "text": {
    "L1": "Elapsed time means how long an activity takes. Count on from its start time.",
    "L2": "First jump to the next full hour, then count whole hours, then the extra minutes.",
    "L3": "From 8:45 to 9:00 is 15 minutes, to 11:00 is 2 hours, and to 11:20 is 20 minutes.",
    "L4": "Add the parts: 2 hours and 15 plus 20 minutes makes 2 hours 35 minutes.",
    "L5": "Do not subtract clock times like ordinary numbers. From 1:50 to 2:00 is 10 minutes, then 10 more to 2:10.",
    "L6": "Sixty minutes make 1 hour, so a clock never shows more than 59 minutes.",
    "L7": "For days ahead, start counting on the day after today. A week has 7 days.",
    "L8": "Now find the time from 9:40 a.m. to 11:10 a.m."
   },
