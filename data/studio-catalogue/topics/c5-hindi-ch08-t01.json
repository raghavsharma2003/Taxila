   "text": {
    "L1": "काजीरंगा राष्ट्रीय उद्यान असम में, ब्रह्मपुत्र नदी के किनारे फैला है।",
    "L2": "कुछ लोग सोचते हैं कि राष्ट्रीय उद्यान एक बड़ा चिड़ियाघर होता है। यह भ्रम गलत है।",
    "L3": "राष्ट्रीय उद्यान में जानवर पिंजरों में नहीं रहते, बल्कि खुले जंगल में आज़ाद घूमते हैं।",
    "L4": "काजीरंगा एक सींग वाले गैंडे के लिए प्रसिद्ध है।",
    "L5": "यहाँ जंगली भैंसे, बारहसिंगे और रंग-बिरंगे पक्षी भी दिखाई देते हैं।",
    "L6": "ऊँची हाथी घास के पार देखने के लिए जीप या हाथी की सवारी उपयोगी रहती है।",
    "L7": "गैंडों को बचाना ज़रूरी है, क्योंकि वे बहुत कम बचे हैं और शिकार से उन्हें खतरा है।",
    "L8": "अब बताइए, काजीरंगा किस राज्य में है?"
   },
   "narration": {
    "L1": {
     "text": "काजीरंगा राष्ट्रीय उद्यान असम में, ब्रह्मपुत्र नदी के किनारे फैला है।",
     "dur": 7,
