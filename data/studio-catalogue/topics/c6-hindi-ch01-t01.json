   "text": {
    "L1": "‘मातृभूमि’ कविता अपने देश, यानी भारत, के प्रति प्रेम और गर्व की बात करती है।",
    "L2": "एक भ्रम है कि सही शब्द ‘मात्रभूमि’ है। यह सही नहीं है।",
    "L3": "सही शब्द ‘मातृभूमि’ है: मातृ में त के नीचे ऋ की मात्रा ‘ृ’ लगती है।",
    "L4": "मातृ का अर्थ ‘माता का’ और भूमि का अर्थ ‘धरती’ है। इसलिए मातृभूमि माँ जैसी धरती है।",
    "L5": "देश को माँ जैसा इसलिए मानते हैं, क्योंकि वह हमें अन्न, पानी, घर और प्यार देकर पालती है।",
    "L6": "कविता हिमालय, नदियों, समुद्र और हरे खेतों जैसी प्रकृति की सुंदरता का गुणगान करती है।",
    "L7": "इसे पढ़ते समय हर पंक्ति के अंत में रुकें और गर्व भरी, स्थिर आवाज़ रखें।",
    "L8": "अब अपनी समझ जाँचो और कविता का मुख्य भाव चुनो।"
   },
