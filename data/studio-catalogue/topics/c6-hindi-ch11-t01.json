   "text": {
    "L1": "चेतक महाराणा प्रताप का घोड़ा था और हल्दीघाटी के युद्ध के लिए याद किया जाता है।",
    "L2": "उसकी तेज़ी, निडरता और अपने स्वामी के प्रति वफ़ादारी उसकी बड़ी खूबियाँ थीं।",
    "L3": "कविता में कहा गया है कि चेतक हवा से भी तेज़ दौड़ा।",
    "L4": "इसे सचमुच हवा से तेज़ दौड़ना मत समझिए और इसे झूठ भी मत कहिए।",
    "L5": "कवि ने तेज़ी का असर महसूस कराने के लिए बात को बढ़ा-चढ़ाकर कहा है।",
    "L6": "सीधी बात ‘बहुत तेज़’ है, जबकि ‘हवा से भी तेज़’ अतिशयोक्ति है।",
    "L7": "युद्ध, साहस और वीरता का जोशीला वर्णन कविता में वीर रस जगाता है।",
    "L8": "इसलिए इसे तेज़, मजबूत और लयबद्ध आवाज़ में पढ़ने से कविता का ओज बना रहता है।"
   },
