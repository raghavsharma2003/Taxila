   "text": {
    "L1": "यह नाटक बताता है कि तेनाली की बुद्धि ने दरबारियों की चाल को मात दी।",
    "L2": "भ्रम यह है कि कोष्ठक में लिखी बातें भी संवाद की तरह बोलनी हैं। यह सही नहीं है।",
    "L3": "ईर्ष्यालु दरबारियों ने राजा से झूठ कहा कि तेनाली शतरंज का अद्भुत खिलाड़ी है। तेनाली हारे और राजा क्रोधित हुए।",
    "L4": "राजा ने भरी सभा में तेनाली का सिर मुँड़वाने की सज़ा सुनाई।",
    "L5": "तेनाली ने कहा कि उसके बालों पर पाँच हज़ार अशर्फ़ियाँ उधार हैं। राजा ने उसे पाँच हज़ार अशर्फ़ियाँ दिलवा दीं।",
    "L6": "फिर तेनाली ने राजा को अपने माता-पिता जैसा बताया। राजा ने डरकर सज़ा वापस ले ली।",
    "L7": "इसलिए शतरंज में तेनाली हारा, पर अपनी चतुराई से असल में जीत गया। दरबारियों की चाल को मात मिली।",
    "L8": "नाटक में कोष्ठक वाली बात करके दिखाते हैं, बोलते नहीं। संवाद ही पात्र बोलता है।"
   },
   "narration": {
    "L1": {
     "text": "यह नाटक बताता है कि तेनाली की बुद्धि ने दरबारियों की चाल को मात दी।",
     "dur": 6.5,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "भ्रम यह है कि कोष्ठक में लिखी बातें भी संवाद की तरह बोलनी हैं। यह सही नहीं है।",
     "dur": 7,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "ईर्ष्यालु दरबारियों ने राजा से झूठ कहा कि तेनाली शतरंज का अद्भुत खिलाड़ी है। तेनाली हारे और राजा क्रोधित हुए।",
     "dur": 8,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "राजा ने भरी सभा में तेनाली का सिर मुँड़वाने की सज़ा सुनाई।",
     "dur": 5.5,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "तेनाली ने कहा कि उसके बालों पर पाँच हज़ार अशर्फ़ियाँ उधार हैं। राजा ने उसे पाँच हज़ार अशर्फ़ियाँ दिलवा दीं।",
     "dur": 8,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "फिर तेनाली ने राजा को अपने माता-पिता जैसा बताया। राजा ने डरकर सज़ा वापस ले ली।",
     "dur": 7,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "इसलिए शतरंज में तेनाली हारा, पर अपनी चतुराई से असल में जीत गया। दरबारियों की चाल को मात मिली।",
     "dur": 7.5,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L8": {
     "text": "नाटक में कोष्ठक वाली बात करके दिखाते हैं, बोलते नहीं। संवाद ही पात्र बोलता है।",
     "dur": 6.5,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    }
   },
