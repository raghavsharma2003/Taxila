   "text": {
    "L1": "साङ्केन अरुणाचल प्रदेश के खाम्ती लोगों का नया साल है। यह त्योहार अप्रैल के मध्य में आता है।",
    "L2": "कुछ लोग सोचते हैं कि पानी डालना बस खेल है। यह भ्रम सही नहीं है।",
    "L3": "पहले दिन बुद्ध की मूर्तियों को बाहर लाकर साफ़ पानी से नहलाया जाता है।",
    "L4": "फिर बच्चे और बड़े एक-दूसरे पर पानी डालते हैं। माना जाता है कि इससे पुराने साल की थकान और बुराइयाँ धुलती हैं।",
    "L5": "यह नई और साफ़ शुरुआत का संकेत है। तीन दिन तक गीत, नाच और पकवान चलते हैं।",
    "L6": "होली की तरह साङ्केन में भी लोग पानी या रंग डालकर खुशी मनाते हैं। फर्क यह है कि साङ्केन खाम्ती लोगों का नया साल है और इसमें बुद्ध की मूर्ति नहलाई जाती है।",
    "L7": "साङ्केन को साङ्-केन बोलो। इसमें ङ, ड़ से अलग है और नाक से बोला जाता है।",
    "L8": "अब क्रम याद करो: पहले मूर्ति नहलाना, फिर पानी डालना, उसके बाद गीत, नाच और पकवान।"
   },
   "narration": {
    "L1": {
     "text": "साङ्केन अरुणाचल प्रदेश के खाम्ती लोगों का नया साल है। यह त्योहार अप्रैल के मध्य में आता है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L2": {
     "text": "कुछ लोग सोचते हैं कि पानी डालना बस खेल है। यह भ्रम सही नहीं है।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "पहले दिन बुद्ध की मूर्तियों को बाहर लाकर साफ़ पानी से नहलाया जाता है।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "फिर बच्चे और बड़े एक-दूसरे पर पानी डालते हैं। माना जाता है कि इससे पुराने साल की थकान और बुराइयाँ धुलती हैं।",
     "dur": 5.5,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L5": {
     "text": "यह नई और साफ़ शुरुआत का संकेत है। तीन दिन तक गीत, नाच और पकवान चलते हैं।",
     "dur": 4.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "होली की तरह साङ्केन में भी लोग पानी या रंग डालकर खुशी मनाते हैं। फर्क यह है कि साङ्केन खाम्ती लोगों का नया साल है और इसमें बुद्ध की मूर्ति नहलाई जाती है।",
     "dur": 7,
     "lead": 0,
     "tail": 0.5,
     "pauses": []
    },
    "L7": {
     "text": "साङ्केन को साङ्-केन बोलो। इसमें ङ, ड़ से अलग है और नाक से बोला जाता है।",
     "dur": 4.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L8": {
     "text": "अब क्रम याद करो: पहले मूर्ति नहलाना, फिर पानी डालना, उसके बाद गीत, नाच और पकवान।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    }
   },
