   "text": {
    "L1": "गाँव की चौपाल पर हरिया और भोला एक बकरी को लेकर झगड़ते हुए आए। दोनों कहते थे, बकरी उनकी है।",
    "L2": "भोला ज़ोर से चिल्लाया, लेकिन ज़ोर से बोलना सच का सबूत नहीं होता।",
    "L3": "समझदार दादी ने दोनों की बात सुनी और बकरी की रस्सी खुलवा दी।",
    "L4": "खुली बकरी सीधी हरिया के आँगन में अपने मेमने के पास चली गई। इससे असली मालिक का पता चला।",
    "L5": "न्याय शोर या पसंद देखकर नहीं, सबूत देखकर किया जाता है।",
    "L6": "दादी ने सच और झूठ अलग करके सही फ़ैसला किया। इसे कहते हैं, दूध का दूध, पानी का पानी करना।",
    "L7": "घटनाओं का सही क्रम है: दोनों आए, रस्सी खुली, बकरी मेमने के पास गई, फिर भोला ने सिर झुकाया।",
    "L8": "अब घटनाओं को इसी सही क्रम में लगाइए।"
   },
   "narration": {
    "L1": {
     "text": "गाँव की चौपाल पर हरिया और भोला एक बकरी को लेकर झगड़ते हुए आए। दोनों कहते थे, बकरी उनकी है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "भोला ज़ोर से चिल्लाया, लेकिन ज़ोर से बोलना सच का सबूत नहीं होता।",
     "dur": 3.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "समझदार दादी ने दोनों की बात सुनी और बकरी की रस्सी खुलवा दी।",
     "dur": 3.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "खुली बकरी सीधी हरिया के आँगन में अपने मेमने के पास चली गई। इससे असली मालिक का पता चला।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "न्याय शोर या पसंद देखकर नहीं, सबूत देखकर किया जाता है।",
     "dur": 3,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "दादी ने सच और झूठ अलग करके सही फ़ैसला किया। इसे कहते हैं, दूध का दूध, पानी का पानी करना।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "घटनाओं का सही क्रम है: दोनों आए, रस्सी खुली, बकरी मेमने के पास गई, फिर भोला ने सिर झुकाया।",
