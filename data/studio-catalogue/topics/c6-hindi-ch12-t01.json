   "text": {
    "L1": "मॉरीशस हिंद महासागर में स्थित एक द्वीप देश है। यह भारत का हिस्सा नहीं है।",
    "L2": "भारत से मॉरीशस दक्षिण-पश्चिम दिशा में है, इसलिए नक़्शे पर दोनों अलग जगह दिखते हैं।",
    "L3": "बहुत समय पहले कई भारतीय गिरमिटिया मज़दूर बनकर गन्ने के खेतों में काम करने वहाँ गए और वहीं बस गए।",
    "L4": "उनके वंशज आज भी हिंदी-भोजपुरी बोलते हैं और भारतीय त्योहार तथा रीति-रिवाज निभाते हैं।",
    "L5": "इसी भाषा और संस्कृति के कारण मॉरीशस को छोटा-सा हिंदुस्तान कहा गया है।",
    "L6": "यात्रा-वृत्तांत लेखक की अपनी सच्ची यात्रा का वर्णन होता है, जिसमें जगह, देखी चीज़ें और अनुभव बताए जाते हैं।",
    "L7": "याद रखिए, समान संस्कृति का अर्थ यह नहीं कि मॉरीशस भारत का राज्य या शहर है।",
    "L8": "अब बताइए, मॉरीशस क्या है?"
   },
