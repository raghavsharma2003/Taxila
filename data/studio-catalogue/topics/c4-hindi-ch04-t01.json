   "text": {
    "L1": "हमारे आहार में तरह-तरह के भोजन होने चाहिए। केवल स्वादिष्ट और पेट भरने वाला खाना काफ़ी नहीं है।",
    "L2": "भ्रम है कि केवल आलू या चिप्स से काम चल जाता है। यह सही नहीं है, क्योंकि शरीर को अलग-अलग भोजन चाहिए।",
    "L3": "चावल, दाल और सब्ज़ी खाने से तन में चुस्ती-फुर्ती आती है। इसलिए केवल आलू मत लाओ।",
    "L4": "भिंडी, परवल और पालक सब्ज़ियाँ हैं; आम, अमरूद, पपीता और केला फल हैं। दूध-दही और सलाद भी आहार में शामिल करो।",
    "L5": "खरबूज़, तरबूज़, ककड़ी और खीरा गरमी की पीड़ा हरते हैं। गरमी में खूब पानी भी पियो।",
    "L6": "हमेशा ताज़ा खाना खाओ और पेट से ज़्यादा मत खाओ। ज़्यादा खाने पर बाद में पछताना पड़ सकता है।",
    "L7": "ढंग से खाओ, तो बीमारी को आने का बहाना नहीं मिलेगा। अब सेहतमंद थाली पहचानो।"
   },
   "narration": {
    "L1": {
     "text": "हमारे आहार में तरह-तरह के भोजन होने चाहिए। केवल स्वादिष्ट और पेट भरने वाला खाना काफ़ी नहीं है।",
     "dur": 5,
     "lead": 0,
