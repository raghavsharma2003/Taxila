     "pauses": []
    },
    "L2": {
     "text": "भ्रम है कि केवल आलू या चिप्स से काम चल जाता है। यह सही नहीं है, क्योंकि शरीर को अलग-अलग भोजन चाहिए।",
     "dur": 5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L3": {
     "text": "चावल, दाल और सब्ज़ी खाने से तन में चुस्ती-फुर्ती आती है। इसलिए केवल आलू मत लाओ।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L4": {
     "text": "भिंडी, परवल और पालक सब्ज़ियाँ हैं; आम, अमरूद, पपीता और केला फल हैं। दूध-दही और सलाद भी आहार में शामिल करो।",
     "dur": 5.5,
     "lead": 0,
