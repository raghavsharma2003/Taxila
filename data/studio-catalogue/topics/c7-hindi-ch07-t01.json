   "text": {
    "L1": "वर्षा-बहार कविता बरसात की रौनक़ और सुंदरता दिखाती है।",
    "L2": "बादल, बिजली, मोर और हरे-भरे खेत वर्षा के चित्र बनाते हैं।",
    "L3": "घने बादल घिरते हैं और चंचल बिजली चमकती है।",
    "L4": "वर्षा देखकर मोर नाचता है, क्योंकि यह उसका प्रिय मौसम है।",
    "L5": "किसान भी खुश होता है, क्योंकि बारिश से खेत सिंचते हैं और फसल अच्छी होती है।",
    "L6": "ध्यान रखो, बहार का अर्थ रौनक़ या खिला हुआ सुहावना मौसम है।",
    "L7": "बाहर का अर्थ किसी जगह के बाहर होता है; इसलिए बहार और बाहर अलग शब्द हैं।",
    "L8": "‘चम-चम चमकी चंचल चपला’ में ‘च’ वर्ण बार-बार आया है। इसे अनुप्रास अलंकार कहते हैं।",
    "L9": "अब बताओ, वर्षा-बहार में बहार का सही अर्थ क्या है?"
   },
   "narration": {
    "L1": {
