   "text": {
    "L1": "मदन बहुत ग़रीब था, इसलिए माँ ने उसे पैसे कमाने के लिए बाहर भेजा।",
    "L2": "रास्ते में उसे कवि सभा और सौ स्वर्ण मुद्राओं का पुरस्कार सुनाई दिया।",
    "L3": "मदन ने जो देखा, उसी से कविता बनाई: पहले कुत्ता ज़मीन खोद रहा था।",
    "L4": "फिर भैंस पानी पी रही थी, चिड़िया झाँक रही थी और साँप सरक रहा था।",
    "L5": "अंत में राजमहल का रास्ता बताने वाले धन्नू शाह का नाम कविता में आ गया।",
    "L6": "रात को राजा कविता दोहरा रहे थे और चोर वही काम कर रहे थे—खोदना, पानी पीना, झाँकना और सरकना।",
    "L7": "चोरों को लगा कि राजा उन्हें देख रहे हैं, इसलिए वे डर गए और धन्नू शाह ने माफ़ी माँगी।",
    "L8": "कविता में जादू नहीं था; संयोग से उसकी पंक्तियाँ चोरों के कामों से मिल गईं, इसलिए ख़ज़ाना बच गया।"
   },
   "narration": {
    "L1": {
     "text": "मदन बहुत ग़रीब था, इसलिए माँ ने उसे पैसे कमाने के लिए बाहर भेजा।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L2": {
     "text": "रास्ते में उसे कवि सभा और सौ स्वर्ण मुद्राओं का पुरस्कार सुनाई दिया।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L3": {
     "text": "मदन ने जो देखा, उसी से कविता बनाई: पहले कुत्ता ज़मीन खोद रहा था।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L4": {
     "text": "फिर भैंस पानी पी रही थी, चिड़िया झाँक रही थी और साँप सरक रहा था।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L5": {
     "text": "अंत में राजमहल का रास्ता बताने वाले धन्नू शाह का नाम कविता में आ गया।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L6": {
     "text": "रात को राजा कविता दोहरा रहे थे और चोर वही काम कर रहे थे—खोदना, पानी पीना, झाँकना और सरकना।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L7": {
     "text": "चोरों को लगा कि राजा उन्हें देख रहे हैं, इसलिए वे डर गए और धन्नू शाह ने माफ़ी माँगी।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L8": {
     "text": "कविता में जादू नहीं था; संयोग से उसकी पंक्तियाँ चोरों के कामों से मिल गईं, इसलिए ख़ज़ाना बच गया।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    }
