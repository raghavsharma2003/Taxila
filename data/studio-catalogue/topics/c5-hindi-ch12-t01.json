   "text": {
    "L1": "मैं गंगा नदी हूँ और अपनी कहानी खुद सुना रही हूँ। इसलिए इस आत्मकथा में ‘मैं’ गंगा है।",
    "L2": "मेरा जन्म उत्तराखंड में गंगोत्री हिमनद के गोमुख से होता है। वहाँ मुझे भागीरथी कहते हैं।",
    "L3": "मैं देवप्रयाग पहुँचती हूँ, जहाँ अलकनंदा मुझसे मिलती है। यहीं से मेरा नाम गंगा पड़ता है।",
    "L4": "फिर मैं हरिद्वार और प्रयागराज पहुँचती हूँ। प्रयागराज में यमुना से मिलना संगम कहलाता है।",
    "L5": "संगम नदियों के मिलने की जगह है, समुद्र नहीं। वाराणसी से आगे जाकर मैं बंगाल की खाड़ी में मिलती हूँ।",
    "L6": "जब लोग मुझमें कचरा डालते हैं, तो मेरा मन दुखता है। हमें कचरा नहीं डालना और प्लास्टिक कम करना चाहिए।",
    "L7": "गंगा की यात्रा का क्रम याद रखो: गोमुख, देवप्रयाग, हरिद्वार, प्रयागराज, वाराणसी।"
   },
   "narration": {
    "L1": {
     "text": "मैं गंगा नदी हूँ और अपनी कहानी खुद सुना रही हूँ। इसलिए इस आत्मकथा में ‘मैं’ गंगा है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "मेरा जन्म उत्तराखंड में गंगोत्री हिमनद के गोमुख से होता है। वहाँ मुझे भागीरथी कहते हैं।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "मैं देवप्रयाग पहुँचती हूँ, जहाँ अलकनंदा मुझसे मिलती है। यहीं से मेरा नाम गंगा पड़ता है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "फिर मैं हरिद्वार और प्रयागराज पहुँचती हूँ। प्रयागराज में यमुना से मिलना संगम कहलाता है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "संगम नदियों के मिलने की जगह है, समुद्र नहीं। वाराणसी से आगे जाकर मैं बंगाल की खाड़ी में मिलती हूँ।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "जब लोग मुझमें कचरा डालते हैं, तो मेरा मन दुखता है। हमें कचरा नहीं डालना और प्लास्टिक कम करना चाहिए।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "गंगा की यात्रा का क्रम याद रखो: गोमुख, देवप्रयाग, हरिद्वार, प्रयागराज, वाराणसी।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    }
   },
