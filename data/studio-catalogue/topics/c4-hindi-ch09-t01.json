   "text": {
    "L1": "छगनलाल हलवाई की दुकान बंद हुई, तो मिठाइयों का सम्मेलन शुरू हुआ।",
    "L2": "लड्डू दादा को सम्मेलन का अध्यक्ष बनाया गया।",
    "L3": "कलाकंद भाई ने चिंता बताई कि डॉक्टर कुछ लोगों को मिठाई खाने से रोक रहे हैं।",
    "L4": "रबड़ी जी ने कहा, ‘जहाँ अति, वहाँ क्षति।’ बहुत ज़्यादा मिठाई खाने से नुकसान होता है।",
    "L5": "एक भ्रम यह है कि मिठाई कभी नहीं खानी चाहिए। यह बात सही नहीं है।",
    "L6": "फैसला हुआ कि मिठाइयों में शक्कर कम हो और लोग जीभ पर नियंत्रण रखें।",
    "L7": "मिठाई खाओ, पर अति मत करो; मेहनत करो और स्वस्थ रहो।",
    "L8": "खुशी के मौकों पर मिठाई बाँटने का रिवाज़ बंद नहीं होगा। अब अपनी समझ जाँचो।"
   },
