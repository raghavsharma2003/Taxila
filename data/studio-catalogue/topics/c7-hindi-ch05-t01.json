   "text": {
    "L1": "शुरू में कथावाचक बीमार होना चाहता था। उसे छुट्टी, लाड़-प्यार और अच्छी चीज़ों की उम्मीद थी।",
    "L2": "यह विचार कहानी का संदेश नहीं है। बीमारी को मज़ेदार समझना एक भ्रम है।",
    "L3": "घर में सबने उसे बीमार मानकर उसकी देखभाल की। तब असली अनुभव शुरू हुआ।",
    "L4": "उसे कड़वी दवा मिली और परहेज़ का फीका खाना खाना पड़ा।",
    "L5": "उसे बिस्तर पर रहना पड़ा, इसलिए खेल और दोस्तों से दूरी हो गई।",
    "L6": "तब उसकी भावनाएँ बदलीं: कल्पना के मज़े से निराशा और तकलीफ़ तक।",
    "L7": "उसने समझा कि बीमारी में मिलने वाली तकलीफ़ें कल्पना के मज़ों से बहुत ज़्यादा हैं।",
    "L8": "इसलिए उसकी इच्छा बदल गई: अब वह ‘नहीं होना बीमार’ चाहता था।"
   },
