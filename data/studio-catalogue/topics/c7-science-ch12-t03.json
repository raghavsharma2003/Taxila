   "text": {
    "L1": "An eclipse needs the Sun, Earth, and Moon in a straight line. The order tells us which shadow falls where.",
    "L2": "A solar eclipse occurs when the Moon is between the Sun and Earth. The Moon's shadow falls on part of Earth.",
    "L3": "A lunar eclipse occurs when Earth is between the Sun and Moon. Earth's shadow falls on the Moon.",
    "L4": "A solar eclipse can happen only at new moon, and a lunar eclipse only at full moon.",
    "L5": "But eclipses do not happen every month. The Moon's orbit is tilted about five degrees, so the line usually misses.",
    "L6": "Moon phases are different from eclipses. They show how much of the Moon's sunlit half we see, not Earth's shadow.",
    "L7": "Never look directly at the Sun, even during an eclipse or through sunglasses. Use pinhole projection or certified eclipse-viewing glasses.",
    "L8": "A lunar eclipse is safe to watch with your naked eyes because you are looking at the Moon, not the Sun."
   },
   "narration": {
    "L1": {
     "text": "An eclipse needs the Sun, Earth, and Moon in a straight line. The order tells us which shadow falls where.",
     "dur": 8,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L2": {
     "text": "A solar eclipse occurs when the Moon is between the Sun and Earth. The Moon's shadow falls on part of Earth.",
     "dur": 8,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L3": {
     "text": "A lunar eclipse occurs when Earth is between the Sun and Moon. Earth's shadow falls on the Moon.",
     "dur": 8,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L4": {
     "text": "A solar eclipse can happen only at new moon, and a lunar eclipse only at full moon.",
     "dur": 7,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L5": {
     "text": "But eclipses do not happen every month. The Moon's orbit is tilted about five degrees, so the line usually misses.",
     "dur": 8,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L6": {
     "text": "Moon phases are different from eclipses. They show how much of the Moon's sunlit half we see, not Earth's shadow.",
     "dur": 8,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L7": {
     "text": "Never look directly at the Sun, even during an eclipse or through sunglasses. Use pinhole projection or certified eclipse-viewing glasses.",
