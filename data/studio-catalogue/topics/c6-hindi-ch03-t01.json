   "text": {
    "L1": "कविता पहली बूँद के सूखी धरती पर गिरने की बात करती है।",
    "L2": "धरती को कवि प्यासी और जीवित दिखाता है, इसलिए बूँद से उसका सुख-दुख महसूस होता है।",
    "L3": "पहली बूँद धरती की लंबी प्यास बुझाती है।",
    "L4": "इसके बाद बीजों से अंकुर फूटते हैं और नया जीवन शुरू होता है।",
    "L5": "‘बूँद मोती-सी चमकी’ में बूँद की तुलना मोती से की गई है।",
    "L6": "‘सी’ तुलना का शब्द है, इसलिए यह उपमा है।",
    "L7": "एक वर्तनी ध्यान से देखो: सही शब्द ‘बूँद’ है, बड़े ऊ और चंद्रबिंदु के साथ।",
    "L8": "चंद्रबिंदु हटाकर ‘बूद’ लिखना या बोलना सही नहीं है।",
    "L9": "अब सही वर्तनी चुनकर अपनी समझ जाँचो।"
   },
