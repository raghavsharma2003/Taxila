   "text": {
    "L1": "खरगोश पेड़ के नीचे सो रहा था। तभी ज़ोर की आवाज़ हुई—धम्म!",
    "L2": "उसने कुछ देखा नहीं, फिर भी समझा कि आसमान गिर रहा है।",
    "L3": "लोमड़ी, भालू और हाथी भी उसके पीछे भागने लगे। उन्होंने खुद कुछ नहीं जाँचा।",
    "L4": "बहुत लोग किसी बात को मान लें, तो वह अपने-आप सच नहीं हो जाती।",
    "L5": "शेर ने भागने के बजाय सबको रोका और पूछा, किसने कहा कि आसमान गिर रहा है?",
    "L6": "शेर सबको पेड़ के नीचे ले गया। वहाँ आसमान नहीं, एक बड़ा-सा फल पड़ा था।",
    "L7": "कहानी की सीख है: बिना जाँचे किसी बात पर भरोसा मत करो और उसे फैलाओ मत।"
   },
   "narration": {
    "L1": {
     "text": "खरगोश पेड़ के नीचे सो रहा था। तभी ज़ोर की आवाज़ हुई—धम्म!",
     "dur": 4,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "उसने कुछ देखा नहीं, फिर भी समझा कि आसमान गिर रहा है।",
     "dur": 3.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "लोमड़ी, भालू और हाथी भी उसके पीछे भागने लगे। उन्होंने खुद कुछ नहीं जाँचा।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "बहुत लोग किसी बात को मान लें, तो वह अपने-आप सच नहीं हो जाती।",
     "dur": 3.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "शेर ने भागने के बजाय सबको रोका और पूछा, किसने कहा कि आसमान गिर रहा है?",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "शेर सबको पेड़ के नीचे ले गया। वहाँ आसमान नहीं, एक बड़ा-सा फल पड़ा था।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "कहानी की सीख है: बिना जाँचे किसी बात पर भरोसा मत करो और उसे फैलाओ मत।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    }
