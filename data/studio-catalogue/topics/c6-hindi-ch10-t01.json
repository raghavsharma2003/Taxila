   "text": {
    "L1": "देवगढ़ के बूढ़े दीवान सरदार सुजान सिंह को नया दीवान चुनना था।",
    "L2": "उम्मीदवार पूरे महीने शिष्ट और सजे-धजे रहे, पर यह अधिकतर दिखावा था।",
    "L3": "यह भ्रम है कि कहानी की परीक्षा लिखित परीक्षा या हॉकी मैच थी।",
    "L4": "असली परीक्षा तब हुई, जब किसान की अनाज से लदी बैलगाड़ी नाले में फँस गई।",
    "L5": "बाक़ी उम्मीदवार निकल गए, लेकिन घायल जानकीनाथ ने गाड़ी निकालने में हाथ बँटाया।",
    "L6": "वह किसान, सुजान सिंह का भेष था; वे सच्ची दया और साहस देख रहे थे।",
    "L7": "इसीलिए जानकीनाथ चुने गए। उनमें दया, साहस और आत्मबल था।",
    "L8": "क्रम याद रखो: पद छोड़ना, उम्मीदवारों का आना, गाड़ी का फँसना, फिर चयन।"
   },
   "narration": {
