   "text": {
    "L1": "कवि कहता है, प्रेम और ज्ञान के दिये जलाते चलो।",
    "L2": "यह कविता केवल असली दीयों और रात के अँधेरे की बात नहीं है।",
    "L3": "दिया प्रेम और ज्ञान का प्रतीक है, जबकि अँधेरा दुख, बुराई और अज्ञान का संकेत है।",
    "L4": "एक दिया थोड़ी जगह रोशन करता है, पर मिलकर जलाएँ तो उजाला दूर तक फैलता है।",
    "L5": "इसलिए बड़ी कठिनाई देखकर भी कोशिश छोड़नी नहीं चाहिए।",
    "L6": "‘स्नेह’ के दो अर्थ यहाँ ठीक बैठते हैं—प्रेम और तेल।",
    "L7": "दिये में तेल भरो और मन में प्रेम रखो; यही कविता का सुंदर संदेश है।",
    "L8": "सही लिखावट ‘स्नेह’ है, ‘सनेह’ नहीं।",
    "L9": "लगातार मिलकर उजाला फैलाएँ, एक दिन अँधेरा मिटेगा।"
   },
   "narration": {
