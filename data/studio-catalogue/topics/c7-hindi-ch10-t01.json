   "text": {
    "L1": "मीरा कृष्ण की भक्त कवयित्री थीं और उन्हें गिरधर गोपाल कहती थीं।",
    "L2": "मीरा का गिरधर, गिरधर कविराय नहीं है; यहाँ गिरधर श्रीकृष्ण का नाम है।",
    "L3": "गिरधर का अर्थ है गोवर्धन पर्वत धारण करने वाला, इसलिए यह कृष्ण के लिए प्रयुक्त नाम है।",
    "L4": "मीरा के पदों में कृष्ण के प्रति पूरा प्रेम और समर्पण है; सांसारिक शान और डर उनके सामने छोटे हैं।",
    "L5": "पद गाने के लिए होता है, उसमें टेक होती है और अंत में कवि की छाप आती है।",
    "L6": "टेक वह पंक्ति है जिस पर गायक हर अंतरे के बाद लौटता है और मुख्य भाव दोहराता है।",
    "L7": "पुराने शब्दों का अर्थ भी समझो: म्हारे यानी मेरे और साँवरो यानी साँवला कृष्ण।",
    "L8": "इसलिए मीरा का पद भक्ति और गान का है, जबकि गिरधर कविराय की कुंडलिया नीति की सीख देती है।"
   },
   "narration": {
    "L1": {
     "text": "मीरा कृष्ण की भक्त कवयित्री थीं और उन्हें गिरधर गोपाल कहती थीं।",
     "dur": 3.2,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L2": {
     "text": "मीरा का गिरधर, गिरधर कविराय नहीं है; यहाँ गिरधर श्रीकृष्ण का नाम है।",
     "dur": 3.4,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L3": {
     "text": "गिरधर का अर्थ है गोवर्धन पर्वत धारण करने वाला, इसलिए यह कृष्ण के लिए प्रयुक्त नाम है।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L4": {
     "text": "मीरा के पदों में कृष्ण के प्रति पूरा प्रेम और समर्पण है; सांसारिक शान और डर उनके सामने छोटे हैं।",
     "dur": 4.2,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L5": {
     "text": "पद गाने के लिए होता है, उसमें टेक होती है और अंत में कवि की छाप आती है।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L6": {
     "text": "टेक वह पंक्ति है जिस पर गायक हर अंतरे के बाद लौटता है और मुख्य भाव दोहराता है।",
     "dur": 4,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L7": {
     "text": "पुराने शब्दों का अर्थ भी समझो: म्हारे यानी मेरे और साँवरो यानी साँवला कृष्ण।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L8": {
