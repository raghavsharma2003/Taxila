   "text": {
    "L1": "लेखक का बचपन एक छोटे-से गाँव में बीता। घर के पीछे आमों का बड़ा बाग़ था।",
    "L2": "गर्मी में वे आम तोड़ते, शाम को गुल्ली-डंडा खेलते और खेत से ताज़ा गन्ना चूसते थे।",
    "L3": "संस्मरण लेखक की अपनी सच्ची यादें होती हैं। इसमें लेखक बड़े होने पर अपने बचपन को ‘मैं’ बनकर याद करता है।",
    "L4": "इसलिए ‘आज सोचता हूँ’ कहने वाला लेखक अपने बीते हुए दिनों को याद कर रहा है।",
    "L5": "‘नौ दो ग्यारह होना’ जोड़ का सवाल नहीं है। यह मुहावरा झटपट भाग जाने के अर्थ में आता है।",
    "L6": "जब माली काका लाठी लेकर आते, तो बच्चे नौ दो ग्यारह हो जाते।",
    "L7": "आज के खेल अलग हो सकते हैं, पर दोस्तों के साथ खेलना तब भी था और आज भी हो सकता है।",
    "L8": "याद रखते हुए, बोलने वाले के अनुसार ‘खेलता था’ या ‘खेलती थी’ कहते हैं।"
   },
   "narration": {
