   "text": {
    "L1": "चिड़िया का पहला घर अंडे जैसा था। उसे लगा, संसार इतना-सा है।",
    "L2": "फिर उसका घर सूखे तिनकों का घोंसला बना, फिर हरी-भरी कोमल शाखें आईं।",
    "L3": "हर नए घर में चिड़िया को संसार फिर इतना-सा ही लगा।",
    "L4": "वह दूर तक उड़कर खुले आसमान में पहुँची और समझी कि संसार बहुत बड़ा है।",
    "L5": "संसार खुद बड़ा नहीं हुआ; चिड़िया बड़ी होती गई और अधिक दूर तक देख पाई।",
    "L6": "आकार, तैयार और सुकुमार—इनका अंत संसार से तुक मिलाता है।",
    "L7": "एक सही वर्तनी भी याद रखें: चिड़िया और उड़ी में नीचे बिंदु वाला ड़ आता है।",
    "L8": "अब घरों और आसमान का सही क्रम लगाकर दिखाओ।"
   },
