     "dur": 6,
     "lead": 0.2,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "बाहर उसे बड़ा मैदान, सूखा पत्ता और पहाड़ जैसा पत्थर दिखा।",
     "dur": 6.5,
