   "text": {
    "L1": "घोंघा एक छोटे-से सुंदर बगीचे में रहता था।",
    "L2": "बगीचे को पार करने में उसे पूरे दो दिन लगते थे।",
    "L3": "माँ की चेतावनी के बावजूद वह दीवार के छेद से बाहर निकल गया।",
    "L4": "बाहर उसे बड़ा मैदान, सूखा पत्ता और पहाड़ जैसा पत्थर दिखा।",
    "L5": "पत्ता सचमुच आकाश नहीं था; घोंघा बहुत छोटा था, इसलिए वह पत्ता उसे बहुत बड़ा लगा।",
    "L6": "फिर उसने लाल चींटे, फुदकती गिलहरी और भागता कुत्ता देखा।",
    "L7": "कहानी के अंत में घोंघे ने इसी बड़ी बाहर की दुनिया में रहने का निश्चय किया।",
    "L8": "अब बहुवचन देखें: घोंघा से घोंघे बनता है।",
    "L9": "गिलहरी की बड़ी ई छोटी इ बनती है और ‘याँ’ जुड़कर गिलहरियाँ बनता है।"
   },
   "narration": {
    "L1": {
     "text": "घोंघा एक छोटे-से सुंदर बगीचे में रहता था।",
