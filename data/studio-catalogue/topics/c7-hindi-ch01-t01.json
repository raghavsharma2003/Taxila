   "text": {
    "L1": "बच्चा माँ से कहानी सुनाने की प्यार भरी ज़िद करता है।",
    "L2": "माँ की कहानी में एक हंस को तीर लगता है और वह घायल होकर गिर पड़ता है।",
    "L3": "सिद्धार्थ उस हंस को बचाता है, लेकिन शिकारी उसे अपना बताता है।",
    "L4": "मिथक है कि हंस उसी का है जिसने पहले तीर मारा।",
    "L5": "यह गलत है, क्योंकि पहले चोट पहुँचाने से किसी का हक़ नहीं बनता।",
    "L6": "न्याय कहता है कि हंस बचाने वाले रक्षक को मिले, क्योंकि रक्षक का हक़ भक्षक से बड़ा है।",
    "L7": "यह कहानी दया और करुणा सिखाती है: जीवन बचाना, चोट पहुँचाने से बड़ा काम है।"
   },
