   "text": {
    "L1": "काननपुर का बूढ़ा और बुद्धिमान राजा अपने इकलौते बेटे के लिए एक सलाहकार चाहता था।",
    "L2": "उसने दरबारियों से पूछा, “क्या मैं बुद्धिमान और ईमानदार राजा हूँ?”",
    "L3": "सब दरबारियों ने राजा को ख़ुश करने वाली तारीफ़ की, पर एक चुप दरबारी ने सच कहा।",
    "L4": "उसने कहा, “राजा अच्छे हैं, पर पहले उनसे भी बढ़कर राजा हुए हैं।”",
    "L5": "राजा सच सुनकर प्रसन्न हुआ और उस दरबारी को असली हीरा दिया।",
    "L6": "बाक़ी दरबारियों को नकली हीरे मिले, क्योंकि उन्होंने झूठा उत्तर दिया था।",
    "L7": "हीरे चमकते तो एक जैसे थे, पर जौहरी की जाँच से असली और नकली का पता चला।",
    "L8": "इसलिए सीख है: ईमानदारी, किसी को ख़ुश करने वाली झूठी बात से अधिक महत्वपूर्ण है।"
   },
   "narration": {
