     "pauses": []
    },
    "L3": {
     "text": "सब दरबारियों ने राजा को ख़ुश करने वाली तारीफ़ की, पर एक चुप दरबारी ने सच कहा।",
     "dur": 8,
     "lead": 0,
     "tail": 0,
