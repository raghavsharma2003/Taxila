   "text": {
    "L1": "साक्षात्कार प्रश्न और उत्तर के रूप में होता है। प्रश्न पूछने वाला साक्षात्कारकर्ता होता है, और दूसरा व्यक्ति अपने शब्दों में उत्तर देता है।",
    "L2": "बंद प्रश्न का उत्तर प्रायः हाँ या ना होता है। ऐसा प्रश्न अनुभव और विचार विस्तार से नहीं खुलवाता।",
    "L3": "खुला प्रश्न कैसे या क्यों से शुरू हो सकता है। इससे व्यक्ति अपनी कहानी और अनुभव विस्तार से बता सकता है।",
    "L4": "इसलिए ‘क्या आपको नाचना पसंद है?’ की जगह पूछिए, ‘आपको कथक से प्रेम कैसे हुआ?’",
    "L5": "बिरजू महाराज महान कथक नर्तक थे। उनके नृत्य-प्रेम, पारिवारिक परंपरा और बरसों के रियाज़ ने उन्हें महान बनाया।",
    "L6": "रियाज़ लगातार अभ्यास है, ताल लय और गिनती है, और घुँघरू पैरों में बाँधी जाने वाली घंटियों की लड़ी है।",
    "L7": "नुक्ता अर्थ बदल सकता है। राज़ का अर्थ रहस्य है, जबकि राज का अर्थ शासन है।",
    "L8": "अब पहचानिए कि इनमें से कौन-सा प्रश्न लंबा और समृद्ध उत्तर बुलाएगा।"
   },
   "narration": {
    "L1": {
     "text": "साक्षात्कार प्रश्न और उत्तर के रूप में होता है। प्रश्न पूछने वाला साक्षात्कारकर्ता होता है, और दूसरा व्यक्ति अपने शब्दों में उत्तर देता है।",
     "dur": 7,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L2": {
     "text": "बंद प्रश्न का उत्तर प्रायः हाँ या ना होता है। ऐसा प्रश्न अनुभव और विचार विस्तार से नहीं खुलवाता।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L3": {
     "text": "खुला प्रश्न कैसे या क्यों से शुरू हो सकता है। इससे व्यक्ति अपनी कहानी और अनुभव विस्तार से बता सकता है।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L4": {
     "text": "इसलिए ‘क्या आपको नाचना पसंद है?’ की जगह पूछिए, ‘आपको कथक से प्रेम कैसे हुआ?’",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L5": {
     "text": "बिरजू महाराज महान कथक नर्तक थे। उनके नृत्य-प्रेम, पारिवारिक परंपरा और बरसों के रियाज़ ने उन्हें महान बनाया।",
     "dur": 6,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L6": {
     "text": "रियाज़ लगातार अभ्यास है, ताल लय और गिनती है, और घुँघरू पैरों में बाँधी जाने वाली घंटियों की लड़ी है।",
     "dur": 6,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L7": {
     "text": "नुक्ता अर्थ बदल सकता है। राज़ का अर्थ रहस्य है, जबकि राज का अर्थ शासन है।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L8": {
     "text": "अब पहचानिए कि इनमें से कौन-सा प्रश्न लंबा और समृद्ध उत्तर बुलाएगा।",
     "dur": 3,
     "lead": 0,
     "tail": 0,
     "pauses": []
    }
   },
