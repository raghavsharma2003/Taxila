   "text": {
    "L1": "यह निबंध वैज्ञानिक जगदीशचंद्र बसु ने लिखा है। वे पेड़ों को सजीव मानते थे।",
    "L2": "एक भ्रम है कि पेड़ सजीव नहीं, क्योंकि वह चल या बोल नहीं सकता। यह बात गलत है।",
    "L3": "पेड़ बढ़ता है, भोजन और पानी लेता है, साँस लेता है और बीज से नए पेड़ बनाता है।",
    "L4": "बीज पहले मिट्टी में चुपचाप पड़ा रहता है। पानी मिलने पर उसमें से अंकुर फूटता है।",
    "L5": "अंकुर की जड़ नीचे जाती है और कोंपल रोशनी पाने के लिए ऊपर बढ़ती है।",
    "L6": "उसके बाद पौधा धूप की ओर बढ़कर पेड़ बन जाता है। अंत में फूल-फल आते हैं।",
    "L7": "पेड़ हमारे मित्र हैं। वे छाँव, फल-फूल और साफ़ हवा देते हैं, और पक्षियों को घर देते हैं।",
    "L8": "अब बीज से पेड़ बनने की यात्रा को सही क्रम में लगाइए।"
   },
   "narration": {
    "L1": {
     "text": "यह निबंध वैज्ञानिक जगदीशचंद्र बसु ने लिखा है। वे पेड़ों को सजीव मानते थे।",
     "dur": 6.2,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L2": {
     "text": "एक भ्रम है कि पेड़ सजीव नहीं, क्योंकि वह चल या बोल नहीं सकता। यह बात गलत है।",
     "dur": 6.2,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L3": {
     "text": "पेड़ बढ़ता है, भोजन और पानी लेता है, साँस लेता है और बीज से नए पेड़ बनाता है।",
     "dur": 6.5,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L4": {
     "text": "बीज पहले मिट्टी में चुपचाप पड़ा रहता है। पानी मिलने पर उसमें से अंकुर फूटता है।",
     "dur": 6.2,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L5": {
     "text": "अंकुर की जड़ नीचे जाती है और कोंपल रोशनी पाने के लिए ऊपर बढ़ती है।",
     "dur": 6.1,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L6": {
     "text": "उसके बाद पौधा धूप की ओर बढ़कर पेड़ बन जाता है। अंत में फूल-फल आते हैं।",
     "dur": 6.1,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L7": {
     "text": "पेड़ हमारे मित्र हैं। वे छाँव, फल-फूल और साफ़ हवा देते हैं, और पक्षियों को घर देते हैं।",
     "dur": 6.5,
     "lead": 0,
     "tail": 0.4,
