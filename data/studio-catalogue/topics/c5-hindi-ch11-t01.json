   "text": {
    "L1": "भारत में कुछ ऐतिहासिक जगहें कला के घर हैं। इसलिए उन्हें कलामंदिर कहते हैं।",
    "L2": "अजंता की गुफ़ाओं की दीवारों पर बहुत पुराने रंगीन चित्र आज भी दिखते हैं।",
    "L3": "एलोरा में कैलाश मंदिर एक ही विशाल चट्टान को ऊपर से नीचे काटकर बनाया गया।",
    "L4": "शिल्पकारों ने छेनी और हथौड़ी से पत्थर गढ़े। एक ग़लत चोट से चट्टान ख़राब हो सकती थी।",
    "L5": "कोणार्क का सूर्य मंदिर एक बड़े रथ जैसा है, जिसमें चौबीस पहिए और सात घोड़े हैं।",
    "L6": "इन कलाकृतियों में कलाकारों की मेहनत और श्रद्धा दिखाई देती है। ये हमारी धरोहर हैं।",
    "L7": "भ्रम यह है कि पुराने स्मारक पर नाम खरोंचने से कोई असली नुकसान नहीं होता।",
    "L8": "यह गलत है। खरोंच से चित्र और नक़्क़ाशी खराब होते हैं, इसलिए दीवार पर न लिखें और कचरा न फैलाएँ।",
    "L9": "अब बताओ, रंगीन चित्रों के लिए कौन-सी जगह प्रसिद्ध है?"
   },
   "narration": {
    "L1": {
     "text": "भारत में कुछ ऐतिहासिक जगहें कला के घर हैं। इसलिए उन्हें कलामंदिर कहते हैं।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L2": {
     "text": "अजंता की गुफ़ाओं की दीवारों पर बहुत पुराने रंगीन चित्र आज भी दिखते हैं।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L3": {
     "text": "एलोरा में कैलाश मंदिर एक ही विशाल चट्टान को ऊपर से नीचे काटकर बनाया गया।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L4": {
     "text": "शिल्पकारों ने छेनी और हथौड़ी से पत्थर गढ़े। एक ग़लत चोट से चट्टान ख़राब हो सकती थी।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L5": {
     "text": "कोणार्क का सूर्य मंदिर एक बड़े रथ जैसा है, जिसमें चौबीस पहिए और सात घोड़े हैं।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L6": {
     "text": "इन कलाकृतियों में कलाकारों की मेहनत और श्रद्धा दिखाई देती है। ये हमारी धरोहर हैं।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L7": {
     "text": "भ्रम यह है कि पुराने स्मारक पर नाम खरोंचने से कोई असली नुकसान नहीं होता।",
     "dur": 4,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L8": {
     "text": "यह गलत है। खरोंच से चित्र और नक़्क़ाशी खराब होते हैं, इसलिए दीवार पर न लिखें और कचरा न फैलाएँ।",
     "dur": 5,
     "lead": 0,
     "tail": 0,
     "pauses": []
    },
    "L9": {
     "text": "अब बताओ, रंगीन चित्रों के लिए कौन-सी जगह प्रसिद्ध है?",
     "dur": 3,
