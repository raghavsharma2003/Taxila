   "text": {
    "L1": "रहीम के दोहे छोटी कविताएँ हैं, जिनमें जीवन की सीख छिपी होती है।",
    "L2": "पहले एक भ्रम दूर करें: दोहे में चार पंक्तियाँ नहीं होतीं।",
    "L3": "दोहा दो पंक्तियों का होता है, और हर पंक्ति के दो चरण होते हैं।",
    "L4": "हर पंक्ति में बीच का विराम तेरहवीं मात्रा के बाद आता है। इसके बाद ग्यारह मात्राएँ होती हैं।",
    "L5": "पंक्ति के अंत में तुक मिलती है, इसलिए दोहा सुनने में लयबद्ध लगता है।",
    "L6": "पेड़ फल और तालाब पानी अपने लिए नहीं रखते। अच्छे लोग अपनी चीज़ें दूसरों की भलाई के लिए लगाते हैं।",
    "L7": "रहीम यह भी कहते हैं कि छोटी चीज़ को बेकार मत समझो। जहाँ सुई काम आती है, वहाँ तलवार नहीं आ सकती।",
    "L8": "अब बताइए: दोहे में कितनी पंक्तियाँ होती हैं?"
   },
   "narration": {
    "L1": {
     "text": "रहीम के दोहे छोटी कविताएँ हैं, जिनमें जीवन की सीख छिपी होती है।",
     "dur": 4.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "पहले एक भ्रम दूर करें: दोहे में चार पंक्तियाँ नहीं होतीं।",
     "dur": 3.8,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "दोहा दो पंक्तियों का होता है, और हर पंक्ति के दो चरण होते हैं।",
     "dur": 4.1,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "हर पंक्ति में बीच का विराम तेरहवीं मात्रा के बाद आता है। इसके बाद ग्यारह मात्राएँ होती हैं।",
     "dur": 5.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "पंक्ति के अंत में तुक मिलती है, इसलिए दोहा सुनने में लयबद्ध लगता है।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "पेड़ फल और तालाब पानी अपने लिए नहीं रखते। अच्छे लोग अपनी चीज़ें दूसरों की भलाई के लिए लगाते हैं।",
     "dur": 6.2,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "रहीम यह भी कहते हैं कि छोटी चीज़ को बेकार मत समझो। जहाँ सुई काम आती है, वहाँ तलवार नहीं आ सकती।",
     "dur": 5.8,
     "lead": 0,
     "tail": 0.3,
