   "text": {
    "L1": "चाचा नया कैमरा लाए और छोटू को फ़ोटो के लिए बुलाया।",
    "L2": "छोटू ने सोचा, कैमरे के अंदर एक पेंटर छिपा है। चाचा हँस पड़े।",
    "L3": "चाचा ने बताया, अंदर कोई पेंटर नहीं है। यह प्रकाश और छाया का खेल है।",
    "L4": "क्लिक करते ही रूप काग़ज़ पर आ जाता है, जैसा वह है—हू-ब-हू।",
    "L5": "कैमरा फूलों की फुलवारी, कोयल, कौआ और गौरैया को खींच सकता है।",
    "L6": "दादी, अम्मा और बड़के भैया भी फ़ोटो में खिंच आएँगे।",
    "L7": "‘कैमरा’ ऐसे लिखो: कै + म + रा। क पर ै, यानी ऐ की मात्रा, आएगी।",
    "L8": "कविता में छोटू—फोटू और चित्र—मित्र तुक मिलाते हैं। अब बताओ, कैमरा कौन लाया?"
   },
