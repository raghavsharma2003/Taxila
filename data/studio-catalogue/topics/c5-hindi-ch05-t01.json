   "text": {
    "L1": "सुंदरिया घर की भूरी बछिया थी। उसके माथे पर सफ़ेद चाँद-सा निशान था।",
    "L2": "लेखक उसे बहुत प्यार करता था और रोज़ हरी घास खिलाता था।",
    "L3": "एक दिन सुंदरिया ने खाना छोड़ दिया, तो लेखक का मन चिंतित और दुखी हो गया।",
    "L4": "बाबा पशु-डॉक्टर को बुला लाए। माँ, बाबा और लेखक ने तीन दिन तक उसकी दवा और सेवा की।",
    "L5": "तीन दिन बाद सुंदरिया फिर उछलने लगी, तो घर में त्योहार जैसा आनंद छा गया।",
    "L6": "याद रखो, ‘उसकी बछिया’ कहेंगे, क्योंकि ‘बछिया’ स्त्रीलिंग शब्द है।",
    "L7": "‘आँखों का तारा होना’ का अर्थ आँख में तारा होना नहीं, बहुत प्यारा होना है।",
    "L8": "प्यार से पाला गया जानवर भी घर की सदस्य जैसा बन जाता है।"
   },
