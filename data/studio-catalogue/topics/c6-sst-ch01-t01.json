   "text": {
    "L1": "Maps help us locate places using scale, directions, and symbols.",
    "L2": "Latitude and longitude are different kinds of imaginary lines.",
    "L3": "Latitude tells how far north or south a place is from the Equator.",
    "L4": "Longitude tells how far east or west a place is from the Prime Meridian.",
    "L5": "New Delhi is where 28.6°N and 77.2°E cross.",
    "L6": "Indian astronomers once used Ujjain as a reference meridian.",
    "L7": "India's time is 5 hours 30 minutes ahead of Greenwich because IST uses 82.5°E.",
    "L8": "Now check: which 0° line is longitude?"
   },
