   "text": {
    "L1": "अमर ने जयपुर से अपने पिताजी को पत्र लिखा। आज हम पत्र के हिस्सों का सही क्रम सीखेंगे।",
    "L2": "पत्र के हिस्से किसी भी क्रम में नहीं लिखे जाते। हर हिस्सा अपनी सही जगह पर आता है।",
    "L3": "सबसे ऊपर दाईं ओर दिनांक लिखते हैं। इसके बाद संबोधन होता है, जैसे ‘पूज्य पिताजी’।",
    "L4": "संबोधन के बाद अभिवादन लिखा जाता है—‘सादर प्रणाम!’ फिर आती है पत्र की मुख्य बात।",
    "L5": "अमर ने मुख्य बात में जयपुर की सैर के बारे में लिखा—हवामहल, जंतर-मंतर और रामनिवास बाग का संग्रहालय।",
    "L6": "आमेर के दुर्ग में उसने शीशमहल देखा। पत्र के अंत में समापन और नाम आते हैं—‘आपका पुत्र, अमर’।",
    "L7": "बड़े व्यक्ति को पत्र लिखते समय ‘आप’ कहते हैं। लड़की लिखे तो समापन होगा—‘आपकी पुत्री, लता’।",
    "L8": "अब पत्र के हिस्सों को सही क्रम में लगाकर दिखाइए।"
   },
   "narration": {
    "L1": {
     "text": "अमर ने जयपुर से अपने पिताजी को पत्र लिखा। आज हम पत्र के हिस्सों का सही क्रम सीखेंगे।",
     "dur": 5.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "पत्र के हिस्से किसी भी क्रम में नहीं लिखे जाते। हर हिस्सा अपनी सही जगह पर आता है।",
     "dur": 4.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "सबसे ऊपर दाईं ओर दिनांक लिखते हैं। इसके बाद संबोधन होता है, जैसे ‘पूज्य पिताजी’।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "संबोधन के बाद अभिवादन लिखा जाता है—‘सादर प्रणाम!’ फिर आती है पत्र की मुख्य बात।",
     "dur": 5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "अमर ने मुख्य बात में जयपुर की सैर के बारे में लिखा—हवामहल, जंतर-मंतर और रामनिवास बाग का संग्रहालय।",
     "dur": 6,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "आमेर के दुर्ग में उसने शीशमहल देखा। पत्र के अंत में समापन और नाम आते हैं—‘आपका पुत्र, अमर’।",
     "dur": 5.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "बड़े व्यक्ति को पत्र लिखते समय ‘आप’ कहते हैं। लड़की लिखे तो समापन होगा—‘आपकी पुत्री, लता’।",
     "dur": 5.5,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L8": {
     "text": "अब पत्र के हिस्सों को सही क्रम में लगाकर दिखाइए।",
     "dur": 2.5,
     "lead": 0,
