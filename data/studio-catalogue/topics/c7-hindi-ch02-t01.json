   "text": {
    "L1": "बुद्धिमान होना केवल बूढ़ा होना या बहुत-सी बातें याद करना नहीं है।",
    "L2": "सच्ची बुद्धिमानी ध्यान से देखने और संकेतों से सोचने में है।",
    "L3": "कथा में पहले एक समस्या आती है: राजा का घोड़ा खो जाता है।",
    "L4": "बुद्धिमान लोग खुरों के निशान जैसे छोटे संकेत ध्यान से देखते हैं।",
    "L5": "वे संकेतों को जोड़कर अनुमान लगाते हैं; अनुमान तुक्का नहीं होता।",
    "L6": "फिर वे अपना नतीजा और उसका कारण बताते हैं। यही समझदारी है।",
    "L7": "लोककथा लोगों की सुनी-सुनाई कहानी होती है, जो पीढ़ी-दर-पीढ़ी चलती है।",
    "L8": "अब घटनाओं को सही क्रम में लगाकर अपनी समझ जाँचो।"
   },
