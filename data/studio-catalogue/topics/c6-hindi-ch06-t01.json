   "text": {
    "L1": "यह पाठ रामप्रसाद ‘बिस्मिल’ की आत्मकथा है। इसमें लेखक अपनी आवाज़ में ‘मैं’ कहकर बोलते हैं।",
    "L2": "भ्रम यह है कि आत्मकथा और जीवनी एक ही होती हैं। ऐसा नहीं है।",
    "L3": "आत्मकथा में व्यक्ति अपनी ज़िंदगी खुद लिखता है, जबकि जीवनी कोई दूसरा व्यक्ति लिखता है।",
    "L4": "लेखक की माँ उनके सबसे बड़े सहारे और हिम्मत का स्रोत थीं।",
    "L5": "उन्होंने अच्छे संस्कार दिए, सही राह दिखाई और कठिन समय में साथ दिया।",
    "L6": "इसी स्नेह और साहस से लेखक को देश-सेवा की प्रेरणा मिली।",
    "L7": "पहले व्यक्ति के ‘मैं’ को तीसरे व्यक्ति में बदलते समय ‘उन्होंने’ और ‘उन्हें’ जैसे शब्द आते हैं।",
    "L8": "अब पहचानिए: अपनी ज़िंदगी स्वयं लिखी गई हो, तो वह आत्मकथा है।"
   },
