   "text": {
    "L1": "सूरदास का यह पद ब्रजभाषा में है और गाने के लिए है।",
    "L2": "नन्हे कृष्ण मैया से कहते हैं, ‘मैं नहिं माखन खायो।’",
    "L3": "आज की हिंदी में यही बात है: ‘मैंने माखन नहीं खाया।’",
    "L4": "कृष्ण कहते हैं कि वे सुबह से शाम तक गायें चराने जाते हैं।",
    "L5": "वे यह भी कहते हैं कि छोटे हाथ ऊँचे छींके तक कैसे पहुँचेंगे।",
    "L6": "मुँह पर माखन देखकर वे ग्वाल-बालों पर दोष भी लगा देते हैं।",
    "L7": "यशोदा उनकी भोली-चतुर बातें सुनकर हँसती हैं और उन्हें गले लगा लेती हैं।",
    "L8": "इस पद का मुख्य भाव वात्सल्य है, केवल सज़ा या झूठ नहीं।"
   },
