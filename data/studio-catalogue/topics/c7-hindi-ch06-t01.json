   "text": {
    "L1": "कुंडलिया को पहचानने के लिए उसकी बनावट और सीख, दोनों देखिए।",
    "L2": "भ्रांति यह है कि हर छह-पंक्ति कविता कुंडलिया होती है। यह गलत है।",
    "L3": "कुंडलिया में छह पंक्तियाँ होती हैं: एक दोहा और एक रोला।",
    "L4": "पहला और आखिरी शब्द एक ही होता है, जैसे ‘पानी’ से शुरू होकर ‘पानी’ पर समाप्त होना।",
    "L5": "दूसरी पंक्ति का अंतिम अंश तीसरी पंक्ति की शुरुआत में दोहराया जाता है: ‘समझो इसका मोल’।",
    "L6": "गिरिधर कविराय नीति के कवि हैं; उनकी कविता जीवन की व्यावहारिक सीख देती है।",
    "L7": "पाछे, गुन, कहै और जावैं गलतियाँ नहीं, पुराने लोकभाषा-रूप हैं; इनके आज के रूप हैं पीछे, गुण, कहे और जाएँ।"
   },
