   "text": {
    "L1": "यह पाठ ‘गोल’ हॉकी के एक संस्मरण की सच्ची घटना सुनाता है।",
    "L2": "मैच में विरोधी खिलाड़ी ने लेखक के सिर पर हॉकी स्टिक मार दी।",
    "L3": "लेखक ने गुस्से में वापस मारने के बजाय पट्टी बँधवाई और मैदान में लौट आए।",
    "L4": "उन्होंने जल्दी-जल्दी कई गोल किए और अपने अच्छे खेल से जवाब दिया।",
    "L5": "इसलिए यहाँ ‘बदला’ का अर्थ मारना नहीं, खेल से उत्तर देना है।",
    "L6": "यही खेल-भावना है—ईमानदारी से, नियम से और बिना झगड़े खेलना।",
    "L7": "संस्मरण में लेखक अपनी सच्ची याद ‘मैं’ बनकर सुनाता है।",
    "L8": "अब बताओ, चोट का सही जवाब कौन-सा है?"
   },
