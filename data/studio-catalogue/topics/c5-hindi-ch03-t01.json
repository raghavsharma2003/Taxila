   "text": {
    "L1": "चंदा मामा माँ से कुरता माँगते हैं, ताकि ठंडी रातों से बच सकें।",
    "L2": "माँ हँसकर कहती हैं, कल चाँद पतला था और आज मोटा है। ऐसे बदलते नाप का कुरता कैसे बने?",
    "L3": "यह बात कविता में मज़ेदार है, पर चाँद सचमुच मोटा-पतला नहीं होता।",
    "L4": "चाँद का आकार वही रहता है; हमें उसकी सूरज की रोशनी वाला हिस्सा कम या ज़्यादा दिखता है।",
    "L5": "अमावस्या के बाद चाँद पहले पतली लकीर, फिर आधा चाँद और फिर पूरा गोल दिखता है।",
    "L6": "कविता में ‘आया’ और ‘मचाया’ तुक मिलाने वाले शब्द हैं।",
    "L7": "सही शब्द ‘चाँद’ है, क्योंकि इसमें चंद्रबिंदु की नाक की गूँज सुनाई देती है।",
    "L8": "अब बताओ, अमावस्या के बाद चाँद के रूप किस क्रम में दिखाई देते हैं।"
   },
   "narration": {
