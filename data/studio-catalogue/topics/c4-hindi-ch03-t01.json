   "text": {
    "L1": "नीम कड़वा है, पर कविता उसे बेकार नहीं कहती।",
    "L2": "नीम पक्षियों से नेह जताता है और उन्हें अपना ठिकाना देता है।",
    "L3": "नीम डॉक्टर नहीं है, फिर भी बहुत-से रोग भगाता है।",
    "L4": "जब प्रदूषित हवा चलती है, नीम उसे शुद्ध बना देता है।",
    "L5": "‘कड़वे तन में मीठा मन’ का अर्थ है: बाहर से कड़े हों, फिर भी मन अच्छा रखें।",
    "L6": "नीम किसी से कुछ नहीं लेता, फिर भी सबको बहुत कुछ दे जाता है।",
    "L7": "इसलिए कड़वी चीज़ें भी काम की हो सकती हैं।",
    "L8": "कविता में ‘गाता नीम’ जैसे अंत बार-बार सुनाई देते हैं।"
   },
