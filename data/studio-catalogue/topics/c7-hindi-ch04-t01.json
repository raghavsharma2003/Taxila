   "text": {
    "L1": "यह निबंध कहता है कि बारिश का पानी बहने न दें। उसे तालाबों, झीलों और ज़मीन में सँजोएँ।",
    "L2": "धरती को गुल्लक समझिए: बारिश में पानी जमा करें और गर्मी में ज़रूरत पर निकालें।",
    "L3": "तालाब पानी रोकते हैं। पानी धीरे-धीरे ज़मीन में रिसकर भूजल भरता है।",
    "L4": "भूजल भरने पर कुएँ और हैंडपंप गर्मियों में साथ देते हैं।",
    "L5": "अब एक भ्रम देखें: बाढ़ और अकाल बिल्कुल अलग समस्याएँ हैं।",
    "L6": "यह बात गलत है। पानी को रोककर न सँजोने से बारिश में बाढ़ और गर्मी में अकाल दोनों हो सकते हैं।",
    "L7": "जब पानी बह जाता है, तो भूजल नहीं भरता। इसलिए एक ही लापरवाही दोनों संकट ला सकती है।",
    "L8": "हम छत का पानी टंकी या रिचार्ज गड्ढे में ले जा सकते हैं।",
    "L9": "रोज़ नल बंद रखना और बाल्टी से नहाना भी पानी बचाने के अच्छे उपाय हैं।",
    "L10": "अब क्रम लगाइए: बारिश, तालाब, भूजल और गर्मी में उपयोग।"
   },
