     "dur": 9,
     "lead": 0,
     "tail": 0.5,
     "pauses": []
    },
    "L3": {
     "text": "गेंद सलमा की थी, पर शॉट उसने नहीं मारा। इसलिए केवल रोहन ज़िम्मेदार है।",
     "dur": 7,
