   ],
   "text": {
    "L1": "खिड़की का शीशा टूट गया। रोहन डरते हुए भी सच मानता है कि शॉट उसी ने मारा था।",
    "L2": "एकांकी में कोष्ठक की बातें संवाद नहीं होतीं। वे मंच-निर्देश होती हैं, जैसे कैसे बोलना या क्या करना।",
    "L3": "गेंद सलमा की थी, पर शॉट उसने नहीं मारा। इसलिए केवल रोहन ज़िम्मेदार है।",
    "L4": "सच बोलने के लिए हिम्मत चाहिए। झूठ बोलने पर लोग हम पर विश्वास करना छोड़ देते हैं।",
    "L5": "अध्यापिका का निर्णय न्यायपूर्ण है। रोहन को काम मिला, सलमा को सज़ा नहीं मिली।",
    "L6": "रोहन खेल के बाद गेंदें सँभालेगा और मैदान ठीक रखने में हाथ बँटाएगा।",
    "L7": "याद रखो: एकांकी संवाद और मंच-निर्देश से मंच पर खेला जाता है, और न्याय में ज़िम्मेदारी करने वाले की होती है।"
   },
   "narration": {
    "L1": {
     "text": "खिड़की का शीशा टूट गया। रोहन डरते हुए भी सच मानता है कि शॉट उसी ने मारा था।",
     "dur": 8,
