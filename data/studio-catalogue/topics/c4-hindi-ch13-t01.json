   "text": {
    "L1": "आदित्य का अर्थ सूर्य है। सूर्य हमारे लिए रोशनी और गरमी देता है।",
    "L2": "सूर्य ग्रह नहीं, एक तारा है। वह हाइड्रोजन और हीलियम जैसी बहुत गरम गैसों का विशाल गोला है।",
    "L3": "आदित्य-एल१ सूर्य पर उतरने वाला यान नहीं है। इसरो ने इसे २ सितंबर २०२३ को भेजा।",
    "L4": "यह यान एल१ बिंदु पर सुरक्षित दूरी से सूर्य का अध्ययन करता है और उसके चित्र लेता है।",
    "L5": "सूर्य को कभी सीधे नहीं देखना चाहिए, क्योंकि यह आँखों के लिए ठीक नहीं है।",
    "L6": "वैज्ञानिक सूर्य के बड़े विस्फोटों से उठने वाली आँधियों को समझते हैं, क्योंकि उनका असर पृथ्वी पर पड़ सकता है।",
    "L7": "सवाल पूछते समय सही शब्द चुनें: करने वाले के लिए ‘किसने’, समय के लिए ‘कब’, और स्थान के लिए ‘कहाँ’।",
    "L8": "उत्तर है ‘इसरो ने’। इसलिए सही सवाल होगा: आदित्य-एल१ को किसने भेजा?"
   },
   "narration": {
    "L1": {
     "text": "आदित्य का अर्थ सूर्य है। सूर्य हमारे लिए रोशनी और गरमी देता है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L2": {
     "text": "सूर्य ग्रह नहीं, एक तारा है। वह हाइड्रोजन और हीलियम जैसी बहुत गरम गैसों का विशाल गोला है।",
     "dur": 7,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L3": {
     "text": "आदित्य-एल१ सूर्य पर उतरने वाला यान नहीं है। इसरो ने इसे २ सितंबर २०२३ को भेजा।",
     "dur": 6,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L4": {
     "text": "यह यान एल१ बिंदु पर सुरक्षित दूरी से सूर्य का अध्ययन करता है और उसके चित्र लेता है।",
     "dur": 6,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L5": {
     "text": "सूर्य को कभी सीधे नहीं देखना चाहिए, क्योंकि यह आँखों के लिए ठीक नहीं है।",
     "dur": 5,
     "lead": 0,
     "tail": 0.4,
     "pauses": []
    },
    "L6": {
     "text": "वैज्ञानिक सूर्य के बड़े विस्फोटों से उठने वाली आँधियों को समझते हैं, क्योंकि उनका असर पृथ्वी पर पड़ सकता है।",
     "dur": 7,
     "lead": 0,
     "tail": 0.4,
