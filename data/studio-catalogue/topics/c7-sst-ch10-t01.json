   "text": {
    "L1": "A constitution is a country's basic rulebook. It tells us how government works and protects citizens.",
    "L2": "It sets up government, limits its powers, and lists rights and duties. All other laws must follow it.",
    "L3": "The Constituent Assembly first met on 9 December 1946. Dr Rajendra Prasad led it, and Dr Ambedkar chaired the Drafting Committee.",
    "L4": "After almost three years of debate, the Constitution was adopted on 26 November 1949. It came into force on 26 January 1950.",
    "L5": "The Preamble begins, \"We, the people of India.\" This shows that power comes from the people.",
    "L6": "It aims to secure justice, liberty, equality and fraternity for all. It also describes India as sovereign, socialist, secular, democratic and republican.",
    "L7": "A republic has an elected head of state, not one who inherits the position. India's President is elected by elected representatives.",
    "L8": "Secular does not mean no religion. It means the state has no official religion and treats all religions equally.",
    "L9": "The Constitution is a shared rulebook, and its ideals guide how the country should work.",
    "L10": "Now tap the Preamble word that means India has an elected head of state."
   },
   "narration": {
    "L1": {
     "text": "A constitution is a country's basic rulebook. It tells us how government works and protects citizens.",
     "dur": 5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L2": {
     "text": "It sets up government, limits its powers, and lists rights and duties. All other laws must follow it.",
     "dur": 5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L3": {
     "text": "The Constituent Assembly first met on 9 December 1946. Dr Rajendra Prasad led it, and Dr Ambedkar chaired the Drafting Committee.",
     "dur": 6,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L4": {
     "text": "After almost three years of debate, the Constitution was adopted on 26 November 1949. It came into force on 26 January 1950.",
     "dur": 6,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L5": {
     "text": "The Preamble begins, \"We, the people of India.\" This shows that power comes from the people.",
     "dur": 4,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L6": {
     "text": "It aims to secure justice, liberty, equality and fraternity for all. It also describes India as sovereign, socialist, secular, democratic and republican.",
     "dur": 6,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L7": {
     "text": "A republic has an elected head of state, not one who inherits the position. India's President is elected by elected representatives.",
     "dur": 5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L8": {
     "text": "Secular does not mean no religion. It means the state has no official religion and treats all religions equally.",
     "dur": 5,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L9": {
     "text": "The Constitution is a shared rulebook, and its ideals guide how the country should work.",
     "dur": 4,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    },
    "L10": {
     "text": "Now tap the Preamble word that means India has an elected head of state.",
     "dur": 3,
     "lead": 0,
     "tail": 0.2,
     "pauses": []
    }
