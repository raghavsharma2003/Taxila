   ],
   "text": {
    "L1": "सत्रिया और बिहू, दोनों नृत्य असम के हैं।",
    "L2": "एक भ्रम है कि बिहू केवल नृत्य है। ऐसा नहीं है, क्योंकि बिहू त्योहार भी है।",
    "L3": "सत्रिया की शुरुआत श्रीमंत शंकरदेव ने की और यह सत्रों, यानी वैष्णव मठों में किया जाता था।",
    "L4": "सत्रिया शास्त्रीय नृत्य है, इसलिए इसमें तय नियम, मुद्राएँ और गुरु से लंबी तालीम होती है।",
    "L5": "बिहू असम का त्योहार है। बोहाग या रोंगाली बिहू अप्रैल के बीच में, असमिया नए साल और वसंत के समय मनाया जाता है।",
    "L6": "उस त्योहार पर लोग मिलकर खुले में बिहू लोक नृत्य करते हैं। ढोल या पेपा जैसे वाद्य भी बजते हैं।",
    "L7": "इसलिए सत्रिया नियमों और तालीम वाला शास्त्रीय नृत्य है, जबकि बिहू त्योहार का लोक नृत्य है। अब सही बात चुनो।"
   },
   "narration": {
    "L1": {
     "text": "सत्रिया और बिहू, दोनों नृत्य असम के हैं।",
     "dur": 2.4,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L2": {
     "text": "एक भ्रम है कि बिहू केवल नृत्य है। ऐसा नहीं है, क्योंकि बिहू त्योहार भी है।",
     "dur": 4.8,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L3": {
     "text": "सत्रिया की शुरुआत श्रीमंत शंकरदेव ने की और यह सत्रों, यानी वैष्णव मठों में किया जाता था।",
     "dur": 5.8,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L4": {
     "text": "सत्रिया शास्त्रीय नृत्य है, इसलिए इसमें तय नियम, मुद्राएँ और गुरु से लंबी तालीम होती है।",
     "dur": 5.6,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L5": {
     "text": "बिहू असम का त्योहार है। बोहाग या रोंगाली बिहू अप्रैल के बीच में, असमिया नए साल और वसंत के समय मनाया जाता है।",
     "dur": 6.6,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L6": {
     "text": "उस त्योहार पर लोग मिलकर खुले में बिहू लोक नृत्य करते हैं। ढोल या पेपा जैसे वाद्य भी बजते हैं।",
     "dur": 5.7,
     "lead": 0,
     "tail": 0.3,
     "pauses": []
    },
    "L7": {
     "text": "इसलिए सत्रिया नियमों और तालीम वाला शास्त्रीय नृत्य है, जबकि बिहू त्योहार का लोक नृत्य है। अब सही बात चुनो।",
     "dur": 6.5,
     "lead": 0,
     "tail": 0.5,
     "pauses": []
    }
   },
