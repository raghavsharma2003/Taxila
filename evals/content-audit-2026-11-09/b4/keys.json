    "do": "factor pairs of 36",
    "result": "1 × 36, 2 × 18, 3 × 12, 4 × 9, 6 × 6"
   },
   {
    "do": "perimeter = 2 × (length + width)",
    "result": "74, 40, 30, 26, 24 m"
   },
   {
    "do": "pick the smallest",
    "result": "6 × 6 square: 2 × (6 + 6) = 24 m"
   }
  ],
  "answer": "1 × 36 (74 m), 2 × 18 (40 m), 3 × 12 (30 m), 4 × 9 (26 m), 6 × 6 (24 m); the 6 × 6 square needs the least border, 24 m"
 },
