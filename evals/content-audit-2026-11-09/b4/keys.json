 {
  "id": "EX:c9-maths-ch02-t03-s3",
  "steps": [
   {
    "do": "compare the numbers multiplying x → the rate",
    "result": "12 > 10, so Arjun's line is steeper"
   },
   {
    "do": "put x = 1 in both",
    "result": "10 × 1 + 6 = 16 and 12 × 1 = 12 → Meera ahead"
   },
   {
    "do": "put x = 5 in both",
    "result": "10 × 5 + 6 = 56 and 12 × 5 = 60 → Arjun ahead"
   },
   {
    "do": "start gap 6 km closes by 12 − 10 = 2 km each hour",
    "result": "6 ÷ 2 = 3 hours; 12 × 3 = 36"
   }
  ],
  "answer": "Arjun's line is steeper (12 km per hour against 10); Meera is ahead after 1 hour (16 km against 12 km); Arjun is ahead after 5 hours (60 km against 56 km); they are level after 3 hours, at the 36 km marker"
 },
 {
  "id": "EX:c9-maths-ch09-t02-s2",
  "steps": [
   {
    "do": "what the checks show",
    "result": "the claim holds for n = 1, 2, 3, 4 only"
   },
   {
    "do": "the claim is about every n → infinitely many cases",
    "result": "four checks cannot cover them"
   },
   {
    "do": "test n = 11",
    "result": "121 − 11 + 11 = 121"
   },
   {
    "do": "is 121 prime?",
    "result": "121 = 11 × 11, not prime"
   }
  ],
  "answer": "No; at n = 11 the value is 121 = 11 × 11, which is not prime, so the claim is false"
 },
 {
  "id": "EX:c9-maths-ch02-t02-s1",
  "steps": [
   {
    "do": "A: subtract each value from the next",
    "result": "135 − 120 = 15, 150 − 135 = 15, 165 − 150 = 15"
   },
   {
    "do": "B: same move",
    "result": "3 − 2 = 1, 5 − 3 = 2, 8 − 5 = 3"
   },
   {
    "do": "all differences equal → linear; differences changing → not linear",
    "result": "A is linear (difference 15); B is not linear"
   }
  ],
  "answer": "A is linear, with constant difference 15 L per minute; B is not linear (its differences 1, 2, 3 keep changing)"
 },
 {
  "id": "EX:c9-maths-ch03-t04-s3",
  "steps": [
   {
    "do": "write each in lowest terms first",
    "result": "7/40, 5/12, 9/15 = 3/5"
   },
   {
    "do": "factorise each denominator into primes",
    "result": "40 = 2 × 2 × 2 × 5, 12 = 2 × 2 × 3, 5 = 5"
   },
   {
    "do": "only 2s and 5s → terminates; any other prime → repeats",
    "result": "7/40 and 3/5 terminate; 5/12 repeats"
   },
   {
    "do": "check 7/40 → make the bottom 1000",
    "result": "7/40 = 175/1000 = 0.175"
   }
  ],
  "answer": "7/40 (= 0.175) and 9/15 (= 3/5 = 0.6) terminate; 5/12 does not (it repeats)"
 },
