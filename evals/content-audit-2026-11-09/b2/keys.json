  "id": "EX:c5-maths-ch12-t02-s3",
  "steps": [
   {
    "do": "change minutes to seconds",
    "result": "1 minute = 60 seconds"
   },
   {
    "do": "Kavya's time in seconds",
    "result": "60 + 12 = 72"
   },
   {
    "do": "compare in the same unit",
    "result": "72 is less than 75, so Kavya is faster"
   },
   {
    "do": "difference",
    "result": "75 − 72 = 3"
   }
  ],
  "answer": "Kavya, by 3 seconds"
 },
 {
  "id": "EX:c5-maths-ch02-t01-s1",
  "steps": [
   {
    "do": "bottom number 6 → split 0 to 1 into 6 equal gaps",
    "result": "5 marks in between"
   },
   {
    "do": "one gap = one part of the whole",
    "result": "each gap is 1/6"
   },
   {
    "do": "go 1 gap from 0",
    "result": "the first mark after 0 is 1/6"
   }
  ],
  "answer": "The 1st mark after 0 (0 to 1 split into 6 equal gaps)"
 },
 {
