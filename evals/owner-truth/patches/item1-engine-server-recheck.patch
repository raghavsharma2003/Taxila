+
+const FRAC_RE = /^\s*(-?\d+)\s*\/\s*(\d+)\s*$/;
+/** A plain number or fraction string → number; anything else → null. Exported for tests. */
+export function numericOf(v) {
+  const t = String(v ?? "").trim();
+  const f = t.match(FRAC_RE);
+  if (f) return Number(f[2]) ? Number(f[1]) / Number(f[2]) : null;
+  return /^-?\d+(\.\d+)?$/.test(t.replace(/,/g, "")) ? Number(t.replace(/,/g, "")) : null;
+}
+/**
+ * PURE. Is the committed engine value equal to the verified key? null when either side is not a plain number/fraction
+ * (then the engine's own verdict stands). Reads the value the engines commit: value / written / built / claimed / made /
+ * given, or the picked fraction of a compare (chosen/choice indexing fractions). Exported for tests.
+ */
+export function recheckValue(value, key) {
+  const k = numericOf(key);
+  if (k == null || !value || typeof value !== "object") return null;
+  let v = null;
+  for (const f of ["value", "written", "built", "claimed", "made", "given"]) if (v == null && value[f] != null && typeof value[f] !== "object") v = value[f];
+  const pick = value.chosen ?? value.choice;
+  if (v == null && pick != null && Array.isArray(value.fractions)) v = /^\d+$/.test(String(pick)) ? value.fractions[Number(pick)] : pick;
+  const n = numericOf(v);
+  return n == null ? null : Math.abs(n - k) < 1e-9;
 }
