+  if (GOODBYE.test(t) && !SHORT_BREAK.test(t)) return { type: "goodbye", whole };
+  if (SHORT_BREAK.test(t) && /\b(?:jaana|jana|jau|jaun|go|break|peena|pina|drink|chahiye)\b/.test(t) && !attemptLike(t)) return { type: "break", whole };
