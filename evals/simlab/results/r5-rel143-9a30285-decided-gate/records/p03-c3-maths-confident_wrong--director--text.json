02","skillId":"c3-maths-ch03-t02-s2","lang":"hindi","fractions":[],"numbers":[70,30,100,75,25,100,7,3,7,2],"predict":true}}],"studio":null,"screen":{"chips":[],"ask":"Dekho: 70 + 30 = 100 aur 75 + 25 = 100. Pehle mein dahaai 7 aur 3 hain, doosre mein 7 aur 2 kyun?","pad":false,"whiteboard":"text: Dekho: 70 + 30 = 100 aur 75 + 25 = 100. Pehle mein dahaai…","module":"number-line@1","studio":null,"tray":"module","answerForm":"words"},"end":false,"speakNow":null,"reasons":{"phase":"practice","turn":14,"hintLevel":0,"unclear":0,"verdict":"not_yet","classification":{"outcome":"incorrect","confidence":1,"flags":[],"misconceptionId":null},"item":{"id":"c3-maths-ch03-t02-i08","kind":"contrast"},"probe":null,"kt":[{"id":"8e9663b5-8e1d-4221-ba21-8b9db0806868:28:0","cls":"item.open","outcome":4,"skillIds":["c3-maths-ch03-t02-s3"],"grader":"code"}],"skills":{"c3-maths-ch03-t02-s3":{"before":0.471,"after":0.267,"display":"practising","state":"not_yet"}},"flagged":{"c3-maths-ch03-t02-m-ten-jump-to-decade":3},"guard":{"caught":[],"rewritten":false,"replaced":false,"leadSlot":true},"note":null,"timings":[{"k":"@classified","ms":65},{"k":"@kernel","ms":124},{"k":"chat","d":"taxila-fast","st":200,"ms":1911},{"k":"@replied","ms":2046}]},"ms":2138,"decided":{"itemId":"c3-maths-ch03-t02-i05","skillId":"c3-maths-ch03-t02-s3","kind":"practice","depth":"plain","state":"not","outcome":"wrong","how":"ask.itemId","redraws":0}}],"errors":[],"state":{"c3-maths-ch03-t02-s1":"understood","c3-maths-ch03-t02-s2":"partly","c3-maths-ch03-t02-s3":"not"},"misconceptionsHeld":["c3-maths-ch03-t02-m-ten-jump-to-decade","c3-maths-ch03-t02-m-both-digits-make-ten"],"learning":[],"end":{"summary":"• Practised finding partners that make 100, including 30 + 70 and 80 + 20.\n• Practised number-line jumps using ones and tens to reach 100.\n• Found that 46 to 50 is 4, and counted forward by ones.\n• Initially placed a 10-jump from 65 on 70; later corrected it to 75 by counting.\n• The 65-and-100 partner mix-up (answering 45) was not corrected before the lesson ended.","parentNote":"Asha practised making 100 with tens and using jumps of 1 and 10 on a number line. Vihaan used counting by ones to check that 46 to 50 is 4, and later corrected the 65 + 10 jump from 70 to 75 by counting forward. The partner for 65 to make 100 still needs practice. At home, draw a number line and practise jumps such as 65 + 10 and pairs such as 65 + 35.","did":{"title":"Making 100 and jumps on the number line","shortTitle":"Jumps to 100","cards":[{"kind":"item","ask":"Tumhare paas ₹80 hain. ₹100 banane ke liye aur kitne chahiye?","answer":"बीस! 80 और 20 मिलाकर 100 होते हैं. दस-दस गिनते जाओ न, 90 फिर 100.","tick":true,"withHelp":false,"turnSeq":14},{"kind":"item","ask":"Khaali jagah bharo: Jump to the next ten: 46 to 50 is ___.","answer":"दीदी, मैंने अभी तो चार बोला. स्क्रीन पर फिर से वही सवाल है. उँगली से दिखाऊँ? चार","tick":true,"withHelp":true,"turnSeq":12}],"nextTitle":"Halves and quarters as equal shares","face":"warm","teacher":{"id":"asha","name":"Asha","characterName":"Asha","addressedAs":"Asha didi","pronouns":{"subject":"she","object":"her","possessive":"her"},"voice":"marin","role":"AI teacher","lookRev":1,"signatureColor":"#3E7C74"},"revoiceSeq":14},"facts":{"topic":"Making 100 and jumps on the number line","minutes":1.4,"teachbackPassed":false,"skills":[{"skill":"Find the partner that makes 100 with a tens number (30 + 70)","attempts":3,"unaidedCorrect":2},{"skill":"Use jumps of 1 and 10 on a number line to reach 100","attempts":2,"unaidedCorrect":0}],"misconceptions":[{"belief":"Thinks a jump of 10 from 65 lands on 70 (the next tens number)","timesSeen":1,"correctAfterLastSeen":0}]}},"start":{"ms":2896,"topic":{"id":"c3-maths-ch03-t02","title":"Making 100 and jumps on the number line","chapter":"Double Century"},"teacher":"Asha","address":"tum"},"lessonId":"8e9663b5-8e1d-4221-ba21-8b9db0806868","boardPages":[],"lane2":{"teacher":"director","agent":null},"finishedAt":"2026-10-15T14:51:49