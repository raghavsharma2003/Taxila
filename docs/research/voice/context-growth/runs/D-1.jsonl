{"kind":"turn","turn":1,"clockMin":0.24,"child":"Mujhe cats zyada pasand hain, Chiku bhi hai!","childMs":3850,"probe":null,"afterBarge":false,"move":"hook","topic":"c6-maths-ch07-t04","topicSwitch":false,"insTok":1077,"held":2,"heldAudio":2,"ttfa":841,"words":21,"teacher":"Riya, imagine two cats get equal-sized bowls: one has 1/3, the other 2/3. Which will finish first? Later you’ll teach Bittu.","status":"completed","audioMs":9750,"modalities":["output_audio"],"inTok":1009,"inText":971,"inAudio":38,"cached":448,"cachedText":448,"cachedAudio":0,"outTok":290,"outText":95,"outAudio":195}
