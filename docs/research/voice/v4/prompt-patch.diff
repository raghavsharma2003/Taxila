+export function situationOf(move) {
+  if (!move || move.kind === "safeguard" || move.kind === "wrap") return null;
+  const k = move.kind, s = String(move.shape ?? "");
+  if (k === "worked_example") return "think";
+  if (k === "hint" || k === "reteach" || s.includes(VERDICT_NOTE.not_yet)) return "correct";
+  if (k === "greet") return "greet";
+  if (k === "hook") return "wonder";
+  if (k === "break") return "effort";
+  if (k === "celebrate" || s.startsWith(CONFIRM.correct) || s.startsWith(CONFIRM.whyGood) || s.startsWith(CONFIRM.teachbackPass)) return "success";
+  if (k === "explain" || k === "show_module") return "explain";
+  if (k === "practice" || k === "probe" || k === "retrieval" || k === "teachback" || k === "repair") return "ask";
