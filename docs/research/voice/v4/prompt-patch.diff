+ * note covers both outcomes (right → success, anything else → correct); text-written lanes know the move.
+ * @param {{ move?: any, branches?: any }} x
+ */
+export function spokenNote({ move, branches } = {}) {
+  if (!move || move.kind === "safeguard") return null;
+  const parts = branches?.wrong ? [`right → ${SPOKEN_SHAPE.success}`, `otherwise → ${SPOKEN_SHAPE.correct}`]
