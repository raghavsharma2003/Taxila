diff --git a/tests/voice-talking-rules.test.mjs b/tests/voice-talking-rules.test.mjs
new file mode 100644
index 0000000..9f1cd6d
--- /dev/null
+++ b/tests/voice-talking-rules.test.mjs
@@ -0,0 +1,102 @@
+// TALKING-RULES (docs/research/voice/v4, 2026-10-04): the delivery plan → DragonHD SSML compiler, held to what the v4
+// capability probe measured DragonHD Diya honouring: <break> (floor ~300 ms, X → ~X + 200 ms), slow-downs only,
+// pitch only down and only from -8 %, a question tune from "?". Every rule here is a measured cap, not a taste.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { align, echoIndex, PIVOT } from "../server/voice/expressive/align.js";
+import { momentPlan, ROWS, FILLERS } from "../server/voice/expressive/moment.js";
+import { compileDhd, breakFor, clausesValid, PACE_DELTA, CALM_PITCH } from "../server/voice/expressive/compile/dhd.js";
+import { renderParts, preludeRender } from "../server/voice/expressive/render.js";
+import { createGovernor } from "../server/voice/expressive/governor.js";
+
+const V = { voice: "en-IN-Diya:DragonHDLatestNeural", baseRate: -35 };
+const style = { engine: "dhd", dhd: V, voice: "marin", instructions: "", version: "t", spoken: { mode: "hinglish" } };
+const m = (o) => ({ move: "explain", verdict: "ungraded", engagement: "engaged", childLaughed: false, safety: false, thinkAloud: false,
+  teacherAffect: { display: "neutral_warm", intensity: 1, cause: "none", turn: 1 }, bondStage: "first_sessions", band: "B2", lang: "hinglish", ...o });
+
+test("caps: no speed-up and no pitch-up is ever written; a calm row lowers pitch by 8 %, never 6", () => {
+  assert.equal(PACE_DELTA.brisk, 0, "a clause-level speed-up is not honoured (v4 caps, n=3-4)");
+  assert.ok(Object.values(PACE_DELTA).every((d) => d <= 0));
+  assert.equal(CALM_PITCH, -8);
+  for (const [k, r] of Object.entries(ROWS)) {
+    assert.ok(r.pitch == null || r.pitch === -8, `${k}: pitch ${r.pitch}`);
+    if (k !== "safety") assert.ok(r.sentencePause[0] >= 300, `${k}: a sentence pause under 300 ms cannot be rendered (and none reads as reading)`);
+    assert.deepEqual(r.commaPause, [0, 0], `${k}: a comma is a tune boundary, not a pause`);
+  }
+  assert.ok(!FILLERS.hi.think.includes("हम्म"), "हम्म was heard in 1 of 3 renders");
+});
+
+test("breakFor: a planned pause is written as the break that yields it on DragonHD", () => {
+  assert.equal(breakFor(0), "");
+  assert.equal(breakFor(200), "", "under 250 ms it would come out ~300 ms: not written");
+  assert.equal(breakFor(300), '<break time="100ms"/>');
+  assert.equal(breakFor(600), '<break time="400ms"/>');
+});
+
+test("echo: a short turn-initial echo question gets a beat after it; a real question does not count as one", () => {
+  const joke = align("Cold drink? Phir toh saare paudhe burp karte! Par nahi, paudhe sirf paani peete hain, apni jadon se.",
+    m({ move: "practice", teacherAffect: { display: "playful", intensity: 1, cause: "child_joke", turn: 2 }, childLaughed: true }));
+  assert.equal(joke.row, "laughter");
+  assert.equal(echoIndex(joke.clauses), 0);
+  assert.ok(joke.clauses[1].pauseBeforeMs >= 300, `beat after the echo: ${joke.clauses[1].pauseBeforeMs}`);
+  // the pivot back to the fact gets the "turn" (~600 ms)
+  const pv = joke.clauses.findIndex((c) => PIVOT.test(c.text));
+  assert.ok(pv > 0 && joke.clauses[pv].pauseBeforeMs >= 550, `pivot pause: ${joke.clauses[pv]?.pauseBeforeMs}`);
+  assert.equal(echoIndex([{ text: "Kitna hua?" }, { text: "Socho." }]), -1, "a question word is a real question");
+  assert.equal(echoIndex([{ text: "Achha, ek kaam karte hain, dekho na yeh wala?" }, { text: "Socho." }]), -1, "too long to be an echo");
+  assert.equal(echoIndex([{ text: "Cold drink?" }]), -1, "never the last clause");
+});
+
+test("pitch scope: a correction lowers only its opening sentence; a calm comfort row lowers all; safety never", () => {
+  const corr = align("Achha, chalo isko saath mein dekhte hain. Teen bata chaar, matlab chaar hisse. Ab do bata teen ko dekho.", m({ move: "hint", verdict: "not_yet" }));
+  assert.equal(corr.row, "correct");
+  const firstEnd = corr.clauses.findIndex((c) => /[.!?।]$/.test(c.text));
+  corr.clauses.forEach((c, i) => assert.equal(c.pitch, i <= firstEnd ? -8 : 0, `clause ${i}`));
+  const comfort = align("Koi baat nahi. Thoda ruk jaate hain.", m({ move: "break" }));
+  assert.ok(comfort.clauses.every((c) => c.pitch === -8));
+  const safe = align("Tum safe ho? Kisi bade ko abhi batao.", m({ safety: true }));
+  assert.ok(safe.clauses.every((c) => c.pitch === 0));
+  // ... and the compiled document follows the clause pitch, not the emotion (the middle "reassuring" clause stays level)
+  const ssml = compileDhd(corr.clauses.filter((c) => c.part === corr.clauses.at(-1).part), V, { pitch: corr.pitch });
+  assert.doesNotMatch(ssml, /pitch=/, "the last sentence of a correction is at neutral pitch");
+});
+
+test("think-aloud: slow working, the result at the base rate (never a speed-up), and a >= 300 ms beat at each sentence end", () => {
+  const p = align("Pehle tens, bees aur tees, pachaas. Phir saat aur paanch, baarah. Toh pachaas aur baarah, baasath!", m({ move: "worked_example" }));
+  assert.equal(p.row, "think_aloud");
+  assert.equal(p.clauses.at(-1).pace, "normal");
+  p.clauses.forEach((c, i) => { if (i && /[.!?]$/.test(p.clauses[i - 1].text)) assert.ok(c.pauseBeforeMs >= 300, `clause ${i}`); });
+  assert.ok(p.clauses.every((c, i) => !i || /[.!?]$/.test(p.clauses[i - 1].text) || c.pauseBeforeMs === 0 || i === p.clauses.length - 1), "no comma pause");
+  const r = renderParts({ lessonId: "T", text: "Pehle tens, bees aur tees, pachaas. Phir saat aur paanch, baarah.", style, delivery: p, gov: createGovernor({ now: () => 0 }), log: false });
+  for (const part of r.parts) {
+    for (const rate of part.render.ssml.matchAll(/rate="([-+]\d+)%"/g)) assert.ok(Number(rate[1]) <= V.baseRate, `rate ${rate[1]}`);
+    for (const b of part.render.ssml.matchAll(/<break time="(\d+)ms"\/>/g)) assert.ok(Number(b[1]) >= 50);
+  }
+});
+
+test("validator fails closed: an out-of-range clause is spoken plain", () => {
+  const ok = [{ text: "Achha.", pace: "slow", pitch: -8, pauseBeforeMs: 0 }];
+  assert.ok(clausesValid(ok));
+  assert.ok(!clausesValid([{ ...ok[0], pitch: -6 }]), "pitch -6 is not heard: refused");
+  assert.ok(!clausesValid([{ ...ok[0], pitch: 12 }]), "pitch up is not honoured: refused");
+  assert.ok(!clausesValid([{ ...ok[0], pace: "rushed" }]));
+  assert.ok(!clausesValid([{ ...ok[0], pauseBeforeMs: 9000 }]));
+  assert.ok(!clausesValid([{ ...ok[0], text: "<break/>" }]));
+  const plan = align("Achha, chalo dekhte hain.", m({ move: "hint", verdict: "not_yet" }));
+  const bad = { ...plan, clauses: plan.clauses.map((c) => ({ ...c, pitch: 15 })) };
+  const r = renderParts({ lessonId: "V", text: "Achha, chalo dekhte hain.", style, delivery: bad, gov: createGovernor({ now: () => 0 }), log: false });
+  assert.doesNotMatch(r.parts[0].render.ssml, /pitch=/);
+});
+
+test("the uptake prelude is spoken at neutral pitch whatever CALM_PITCH is", () => {
+  const r = preludeRender("baasath", style);
+  assert.doesNotMatch(r.ssml, /pitch=/);
+});
+
+test("momentPlan carries the row's silence budget; safety plans never get an echo or pivot beat", () => {
+  assert.equal(momentPlan(m({ move: "worked_example" })).silenceCap, 3000);
+  assert.equal(momentPlan(m({ move: "hint", verdict: "not_yet" })).silenceCap, 2500);
+  const s = momentPlan(m({ safety: true }));
+  assert.equal(s.echoPause, undefined);
+  assert.equal(s.pivotPause, undefined);
+});
