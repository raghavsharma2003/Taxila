 /** What the voice says for an "aloud" beat: the title, then the lines in order, as the kit wrote them. */
 export const aloudText = (beat) => [beat.title, ...beat.lines].filter(Boolean).join("\n");
+
+// ───────────── Studio's half (to-brain/023): the board beat on the tray, at the page she is reading from ─────────────
+// A "board" beat is shown by Studio as reading matter (a passage artifact, server/studio/passage.js: the kit's text exactly,
+// paged for a 360 px phone), never a whiteboard. The page is Brain's to say: 1 when the beat runs; on later turns (the question
+// and its hints) the page that holds the part of the text the question is about — `pageFor` finds it from a quoted span of
+// the item's prompt when there is one, else the page stays where it is. Call studioSeam.showPassage on the beat's turn and
+// again whenever the page changes; Studio keeps one piece per passage and only turns its page.
+import { pagePassage, pageAt } from "../studio/passage.js";
+
+/** The page (1-based) of `beat`'s passage that holds the text the item quotes ('…' / "…" / ‘…’ in its English prompt), or `current`. */
+export function pageFor(beat, item, current = 1) {
+  const q = /["“‘']([^"”’']{6,})["”’']/.exec(String(item?.prompt_en ?? ""))?.[1];
+  if (!beat?.text || !q) return current;
+  const at = beat.text.indexOf(q.trim());
+  return at < 0 ? current : pageAt(pagePassage({ text: beat.text }), at);
+}
+
+/** The arguments for studioSeam.showPassage(lessonId, …) for a "board" beat, or null for an "aloud" one. */
+export const studioPassageOf = (beat, { page = 1, lang = null } = {}) =>
+  beat?.mode === "board" ? { passage: { id: beat.passageId, text: beat.text, title: beat.title ?? null, kind: beat.kind ?? null }, page, lang } : null;
