# (src/child/lesson/useDesk.ts:330, which declares its own local type at :43) but UiDirectives does not name it.
# Test: node --test tests/r7-audit-ui-hint-contract.test.mjs (fails before). npx tsc -b passes with it.
diff --git a/shared/contracts.ts b/shared/contracts.ts
index e4a48d2c..05bebaa8 100644
--- a/shared/contracts.ts
+++ b/shared/contracts.ts
@@ -128,6 +128,11 @@ export interface UiDirectives {
   verdict?: "correct" | "not_yet" | "partial";
   /** A correct verdict that came after a hint rung (the tick in outline, §4.6 "With help"). */
   withHelp?: boolean;
+  /**
+   * The Question card's hint line (V2 §4.3, §4.6 "Hint"): sent on a hint move at rungs 1-3 with the kit's rung text, ≤ 120
+   * chars (server: director/state.js hintFor). Never rung 4 (the key), never a line that states the key or reads as a note.
+   */
+  hint?: { level: 1 | 2 | 3; text: string };
   /** The phase line (Older) and the geometry decision. */
   phase?: LessonPhase;
   /** What the tray holds this turn: none → Face layout (no empty box, audit #5). */
diff --git a/tests/r7-audit-ui-hint-contract.test.mjs b/tests/r7-audit-ui-hint-contract.test.mjs
new file mode 100644
index 00000000..d6779cf8
--- /dev/null
+++ b/tests/r7-audit-ui-hint-contract.test.mjs
@@ -0,0 +1,11 @@
+// r7 audit TEACHER-04: ui.hint is produced (director/state.js hintFor) and read (src/child/lesson/useDesk.ts), so the
+// contract between them names it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+
+test("UiDirectives declares hint { level, text }", () => {
+  const src = readFileSync(new URL("../shared/contracts.ts", import.meta.url), "utf8");
+  const ui = src.slice(src.indexOf("export interface UiDirectives"), src.indexOf("\n}\n", src.indexOf("export interface UiDirectives")));
+  assert.match(ui, /\n\s*hint\?:\s*\{\s*level:\s*1 \| 2 \| 3;\s*text:\s*string\s*\}/);
+});
