index 000000000..8801627b8
--- /dev/null
+++ b/tests/r7-app21-short-phone.test.mjs
@@ -0,0 +1,33 @@
+// Audit APP-21 (and the journey audit's 360 × 640 dock): with the number pad up on a 360 × 640 phone the lesson column
+// overflowed and the mic dock sat below the fold (the audit's call: overflow true, the dock's bottom at 700). A short phone
+// now sheds before it overflows: the steer chips while an answer surface is up, then the stage down to its slot minimum,
+// then the slot down to SLOT_FLOOR. Layouts that fit at their full minimum are unchanged.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { solveStage, SLOT_FLOOR, STAGE } from "../src/ui-v3/kaksha/lesson/stageLayout.ts";
+
+test("APP-21: 360 × 640 with the number pad up keeps the dock on screen (chips fold, the slot gives way, nothing overflows)", () => {
+  const r = solveStage({ width: 360, height: 640, family: "older", answerNeed: 232, chips: true, artifact: true });
+  assert.equal(r.overflow, false);
+  assert.ok(r.dock.y + r.dock.h <= 640, `dock bottom ${r.dock.y + r.dock.h}`);
+  assert.equal(r.chips, null, "the steer chips fold while the pad is up on a short phone");
+  assert.ok(r.slot.h >= SLOT_FLOOR, `slot ${r.slot.h}`);
+  assert.ok(r.answer && r.answer.h === 232, "the pad keeps its full size");
+});
+
+test("APP-21: what already fit is unchanged — the chips stay and the stage keeps its full minimum", () => {
+  for (const [w, h] of [[360, 720], [360, 800], [412, 915]]) {
+    const r = solveStage({ width: w, height: h, family: "older", answerNeed: 232, chips: true, artifact: true });
+    assert.equal(r.overflow, false, `${w}x${h}`);
+    assert.ok(r.chips, `${w}x${h}: chips stay`);
+    assert.ok(r.stage.h >= STAGE.stageMin, `${w}x${h}: stage ${r.stage.h}`);
+  }
+  const noPad = solveStage({ width: 360, height: 640, family: "older", chips: true, artifact: true });
+  assert.ok(noPad.chips && noPad.stage.h >= STAGE.stageMin, "no answer surface up: nothing is shed");
+});
+
+test("APP-21: below the floor it still reports overflow (never a slot smaller than SLOT_FLOOR)", () => {
+  const r = solveStage({ width: 360, height: 520, family: "young", answerNeed: 300, chips: true, artifact: true });
+  assert.equal(r.overflow, true);
+  assert.ok(r.slot.h >= SLOT_FLOOR);
+});
