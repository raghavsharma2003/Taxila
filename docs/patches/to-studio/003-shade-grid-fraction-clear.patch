From: audit studio (2026-11-10), finding STUDIO-01
Subject: shade-grid@1 fraction no longer sits on the "N rows" label

With labels on and the fraction shown, every grid of 2+ rows failed its own text-overlap lint (1,080 of 1,080 block
calls): a fraction numwork box starts about 35 units above its `at` row, so at y0 + H + 34 it covered the "N rows"
label. claims-board.js makes exactly this call, so the floor board was refused. Moves the fraction to y0 + H + 56
(the deepest grid still ends inside the 300-unit board). Test: tests/r7-audit-studio-shade-grid.test.mjs fails 2/2
before, passes 2/2 after; the six existing suites that use shade-grid pass (70/70). Apply with `git apply`.

diff --git a/server/forge/explainer/templates.js b/server/forge/explainer/templates.js
index add22df1..0298ccd5 100644
--- a/server/forge/explainer/templates.js
+++ b/server/forge/explainer/templates.js
@@ -436,7 +436,8 @@ function shadeGrid(c, tl) {
   if (c.labels !== false && cols > 1) tl.add({ op: "text", at: [200, y0 - 16], text: `${cols} columns`, size: "s", ink: "soft" }, 400, { gap: 200 });
   if (c.labels !== false && rows > 1) tl.add({ op: "text", at: [200, y0 + H + 18], text: `${rows} rows`, size: "s", ink: "soft" }, 400, { gap: 120 });
   const total = rows * cols;
-  if (withFrac) tl.add({ id: "frac", op: "numwork", at: [186, y0 + H + (c.labels !== false && rows > 1 ? 34 : 14)], layout: "fraction", rows: [[String(shade)], [String(total)]], ink: "accent", weight: 2 }, 700, { gap: 300 });
+  // (audit studio-01: a fraction numwork box starts ~35 units ABOVE its `at` row: under the "N rows" label it needs 56, not 34)
+  if (withFrac) tl.add({ id: "frac", op: "numwork", at: [186, y0 + H + (c.labels !== false && rows > 1 ? 56 : 14)], layout: "fraction", rows: [[String(shade)], [String(total)]], ink: "accent", weight: 2 }, 700, { gap: 300 });
   return { counts: { rows, cols, parts: total, shaded: shade }, facts: { rows, cols, cells: c.hideResult ? "? (child works it out)" : total, shaded: shade } };
 }
 
diff --git a/tests/r7-audit-studio-shade-grid.test.mjs b/tests/r7-audit-studio-shade-grid.test.mjs
new file mode 100644
index 00000000..e6c176b8
--- /dev/null
+++ b/tests/r7-audit-studio-shade-grid.test.mjs
@@ -0,0 +1,26 @@
+// Audit studio-01 (2026-11-10): shade-grid@1 with its row / column labels and a written fraction (her line names the grid
+// and does not ask for the fraction) failed its own text-overlap lint for every grid of 2+ rows: the fraction's box starts
+// ~35 units above its `at` row, so at y0 + H + 34 it sat on the "N rows" label. The claims board (claims-board.js) uses
+// exactly this call (labels: true), so the board was refused and her line pointed at an empty screen.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { expand } from "../server/forge/explainer/templates.js";
+
+test("shade-grid@1: every rows x cols x block, labelled, fraction shown, expands and lints clean", () => {
+  const bad = [];
+  for (let rows = 1; rows <= 6; rows++) for (let cols = 1; cols <= 10; cols++) {
+    if (rows * cols < 2) continue;
+    for (let sr = 1; sr <= rows; sr++) for (let sc = 1; sc <= cols; sc++) for (const hideResult of [false, true]) {
+      const r = expand({ template: "shade-grid@1", rows, cols, block: [sr, sc], labels: true, hideResult });
+      if (!r.ok) bad.push(`${rows}x${cols} block ${sr}x${sc} hide=${hideResult}: ${r.errors[0]}`);
+    }
+  }
+  assert.deepEqual(bad.slice(0, 5), [], `${bad.length} grids refused`);
+});
+
+test("shade-grid@1: the claims board's own call for '5 columns aur 3 rows, shaded hissa 2 columns aur 3 rows' draws", () => {
+  const r = expand({ template: "shade-grid@1", rows: 3, cols: 5, block: [3, 2], labels: true, hideResult: false });
+  assert.equal(r.ok, true, String(r.errors));
+  const frac = r.script.ops.find((o) => o.id === "frac");
+  assert.deepEqual(frac.rows, [["6"], ["15"]]);
+});
