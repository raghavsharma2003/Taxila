diff --git a/tests/forge-g2-wait-scale.test.mjs b/tests/forge-g2-wait-scale.test.mjs
new file mode 100644
index 00000000..869a5d94
--- /dev/null
+++ b/tests/forge-g2-wait-scale.test.mjs
@@ -0,0 +1,14 @@
+// The play check's fixed 4-8 s step waits were the cause of tests/forge-g2-browser.test.mjs flaking under the gate's parallel
+// load (a slow page made the check not-green and the harness asked the scripted builder once more than it had answers for).
+// FORGE_G2_WAIT_SCALE stretches each step wait; the check's own deadline still bounds it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { stepWait } from "../server/forge/g2/qa.js";
+
+test("stepWait: unscaled by default, scaled by FORGE_G2_WAIT_SCALE, never past the check's deadline, never below 1x", () => {
+  assert.equal(stepWait(8000, 60_000, {}), 8000);
+  assert.equal(stepWait(8000, 60_000, { FORGE_G2_WAIT_SCALE: "3" }), 24_000);
+  assert.equal(stepWait(8000, 5_000, { FORGE_G2_WAIT_SCALE: "3" }), 5_000);
+  assert.equal(stepWait(8000, 60_000, { FORGE_G2_WAIT_SCALE: "0.1" }), 8000);
+  assert.equal(stepWait(8000, 60_000, { FORGE_G2_WAIT_SCALE: "nope" }), 8000);
+});
