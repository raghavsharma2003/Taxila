+    for (;;) {
+      const b = this.buf;
+      if (b.length < 2) return;
+      const op = b[0] & 15;
+      let n = b[1] & 127, off = 2;
+      if (n === 126) { if (b.length < 4) return; n = b.readUInt16BE(2); off = 4; } else if (n === 127) { if (b.length < 10) return; n = Number(b.readBigUInt64BE(2)); off = 10; }
