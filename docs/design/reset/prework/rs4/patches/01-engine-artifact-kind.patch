+// Adapter from W2-H's ArtifactRendererProps to the Studio v2 piece (RS-4-owned; lives in this patch because it imports
+// W2-H's types). The stage's fitted box hosts the v2 slot; the host inside does its own 16:10 fit (STUDIO-V2 canvas
+// 1000x625), so the stage letterboxes the rest.
+import type { ArtifactRendererProps } from "../../studio/renderers.ts";
+import { StudioV2Piece } from "./StudioV2Piece.tsx";
+
+export function EngineRenderer({ artifact, reducedMotion, onEvent }: ArtifactRendererProps<"engine">) {
+  return (
+    <StudioV2Piece archetype={artifact.archetype} spec={artifact.spec} reducedMotion={reducedMotion}
+      onEvent={(e) => {
+        if (e.type === "ready") onEvent({ type: "ready" });
+        else if (e.type === "done") onEvent({ type: "done" });
+        // the RAW act (value carries the host's own input record where the engine keeps one); the server re-grades it
+        // from the spec it stored, never a `correct` claim
+        else if (e.type === "answer") onEvent({ type: "answer", value: { archetype: e.archetype, itemId: e.itemId, value: e.value } });
+        // engine_failed / fallback: the board is already on screen; the stage must NOT show an error (R9)
+        else if (e.type === "fallback") onEvent({ type: "interaction", name: "rung_board", data: (e.data ?? {}) as Record<string, unknown> });
+        else if (e.type === "facts") onEvent({ type: "interaction", name: "facts", data: e.facts ?? {} });
+      }} />
+  );
+}
