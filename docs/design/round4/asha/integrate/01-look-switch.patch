diff --git a/tests/p2-face-look.test.mjs b/tests/p2-face-look.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3c37e42cf89bf259cf3414a4875cfae71379c096
--- /dev/null
+++ b/tests/p2-face-look.test.mjs
@@ -0,0 +1,76 @@
+// round 4 (Asha lamp1): the face.look switch and the per-look assets. A look is presentation only: one runtime, one
+// driver, one safety floor. Patch 01 adds the switch (default r8); patch 02 syncs the lamp1-derived runtime; patch 03
+// ships the lamp1 pack; patch 04 makes lamp1 the default. Each check that needs a later patch skips until it is applied.
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+
+const store = new Map();
+globalThis.localStorage = { getItem: (k) => (store.has(k) ? store.get(k) : null), setItem: (k, v) => store.set(k, String(v)), removeItem: (k) => store.delete(k) };
+const L = await import("../src/face-puppet/look.ts");
+const A = await import("../src/face-puppet/assets.ts");
+const exists = (p) => fs.existsSync(new URL(p, import.meta.url));
+
+test("face.look: the deploy default, the device switch, 'default' forgets, junk is ignored", () => {
+  store.clear();
+  assert.equal(L.puppetLookId(), L.DEFAULT_LOOK);
+  L.setPuppetLook("lamp1");
+  assert.equal(L.puppetLookId(), "lamp1");
+  L.setPuppetLook("r8");
+  assert.equal(L.puppetLookId(), "r8");
+  L.setPuppetLook(null);
+  assert.equal(L.puppetLookId(), L.DEFAULT_LOOK);
+  store.set(L.LOOK_FLAG_KEY, "arjun");
+  assert.equal(L.puppetLookId(), L.DEFAULT_LOOK, "an unknown look never reaches the asset table");
+  store.clear();
+});
+
+test("every look has a pack base, a cream, both framings, and a poster path under its own rev", () => {
+  for (const id of L.LOOK_IDS) {
+    const k = A.LOOKS[id];
+    assert.equal(k.rev, id);
+    assert.equal(k.clear.length, 3);
+    for (const f of ["medium", "close"]) {
+      assert.ok([3, 4].includes(k.view[f].length), `${id} ${f} view is [x0,y0,w] or [x0,y0,w,h]`);
+      assert.ok(k.poster(f).startsWith(`/face-puppet/${id}/`));
+    }
+  }
+  assert.equal(A.PUPPET_BASE, `/face-puppet/${A.PUPPET_REV}/`);
+});
+
+test("lamp1 poster placement = the runtime's contain fit (rig.js render), in container units", () => {
+  const k = A.LOOKS.lamp1;
+  for (const f of ["medium", "close"]) {
+    const [x0, y0, w, h] = k.view[f];
+    const st = A.posterStyle(f, k);
+    assert.match(String(st.width), new RegExp(`^calc\\(1024 \\* min\\(100cqw / ${w}, 100cqh / ${h}\\)\\)$`));
+    assert.match(String(st.left), new RegExp(`^calc\\(50cqw - ${x0 + w / 2} \\* min\\(`));
+    assert.match(String(st.top), new RegExp(`^calc\\(50cqh - ${y0 + h / 2} \\* min\\(`));
+    // the same numbers the runtime's camera produces, for the app's own windows (CSS px): the poster's rest-space origin
+    for (const [W, H] of [[325, 316], [375, 405], [440, 440], [319, 172], [80, 80], [78, 100]]) {
+      const sc = Math.min(W / w, H / h), cw = W / sc, ch = H / sc;
+      const camX = x0 + (w - cw) / 2, camY = y0 + (h - ch) / 2;           // rig.js: R.setCam(v0 + (v2 - w) / 2, v1 + (v3 - h) / 2, w)
+      const left = W / 2 - (x0 + w / 2) * sc, top = H / 2 - (y0 + h / 2) * sc; // posterStyle, evaluated
+      assert.ok(Math.abs(left + camX * sc) < 1e-9 && Math.abs(top + camY * sc) < 1e-9, `${f} ${W}x${H}`);
+    }
+  }
+  assert.deepEqual(A.posterStyle("medium", A.LOOKS.r8).width, "100%", "r8 keeps its width-from-the-top poster");
+});
+
+const RUNTIME_LAMP = exists("../src/face-puppet/runtime/face.js");
+test("patch 02: the synced runtime fits 4-element views and reads per-face constants", { skip: RUNTIME_LAMP ? false : "patch 02 (lamp1 runtime) not applied yet" }, () => {
+  const rig = fs.readFileSync(new URL("../src/face-puppet/runtime/rig.js", import.meta.url), "utf8");
+  assert.match(rig, /sc = Math\.min\(cw \/ v\[2\], ch \/ v\[3\]\)/);
+  assert.match(rig, /import \{ F, setFace, onFace \} from "\.\/face\.js"/);
+});
+
+const PACK_LAMP = exists("../public/face-puppet/lamp1/geom.json");
+test("patch 03: the lamp1 pack and its poster are in public/, under the 250 KB budget", { skip: PACK_LAMP ? false : "patch 03 (lamp1 pack) not applied yet" }, () => {
+  const m = JSON.parse(fs.readFileSync(new URL("../public/face-puppet/lamp1/manifest.json", import.meta.url), "utf8"));
+  assert.equal(m.rev, "lamp1");
