+    view: { medium: [110, 25, 830, 875], close: [160, 40, 730, 730] },
+    // one 1024 x 1024 rest frame (the live rig at rest, scripts/character/puppet2d/lamp1/poster.mjs): posterStyle() places
+    // it with the runtime's own contain fit, so the poster and the first live frame line up in any window
