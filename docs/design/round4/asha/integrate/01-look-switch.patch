index 0000000000000000000000000000000000000000..bccd3c01c3d5d017e427c567304f7ed7103a60fe
--- /dev/null
+++ b/src/face-puppet/look.ts
@@ -0,0 +1,59 @@
+// `face.look`: which painted puppet the style-C face wears. Presentation only: the driver, the safety floor, the AI
+// disclosure and the audio path are the same for every look (the runtime is one, src/face-puppet/runtime).
+//   r8    concept C, the first Asha (teal kurta), judged 4.1 (polish r8);
+//   lamp1 round 4, option 4 "Lamplight flat": the grown-up Asha in a cardigan over a print kurta (owner pick 2026-10-10),
+//         docs/design/round4/asha/.
+// Resolution, first hit wins (the same shape as face.puppet2d, flag.ts):
+//   1. `?look=r8|lamp1|default` in any URL (persisted to this device);
+//   2. localStorage "tx.flag.face.look";
+//   3. VITE_FACE_LOOK at build time;
+//   4. DEFAULT_LOOK.
+// Read once per page (assets.ts resolves it at import): a switch takes effect on the next load, never mid-lesson, so a
+// lesson never changes face.
+export type PuppetLookId = "r8" | "lamp1";
+export const LOOK_IDS: readonly PuppetLookId[] = ["r8", "lamp1"];
+/** The deploy default. integrate/04-default-lamp1.patch flips it to "lamp1" once the switch has been checked in the app. */
+export const DEFAULT_LOOK: PuppetLookId = "r8";
+export const LOOK_FLAG_KEY = "tx.flag.face.look";
+
+const isLook = (v: unknown): v is PuppetLookId => typeof v === "string" && (LOOK_IDS as readonly string[]).includes(v);
+
+let urlApplied = false;
+function applyUrl(): void {
+  if (urlApplied) return;
+  urlApplied = true;
+  try {
+    if (typeof location === "undefined") return;
+    const v = new URLSearchParams(location.search).get("look");
+    if (v === "default") setPuppetLook(null);
+    else if (isLook(v)) setPuppetLook(v);
+  } catch {
+    /* no URL / storage */
+  }
+}
+
+export function puppetLookId(): PuppetLookId {
+  applyUrl();
+  try {
+    const v = typeof localStorage !== "undefined" ? localStorage.getItem(LOOK_FLAG_KEY) : null;
+    if (isLook(v)) return v;
+  } catch {
+    /* storage blocked */
+  }
+  const env = import.meta.env?.VITE_FACE_LOOK;
+  return isLook(env) ? env : DEFAULT_LOOK;
+}
+
+export function setPuppetLook(id: PuppetLookId | null): void {
+  try {
+    if (id === null) localStorage.removeItem(LOOK_FLAG_KEY);
+    else localStorage.setItem(LOOK_FLAG_KEY, id);
+  } catch {
+    /* storage blocked */
+  }
+}
+
+/** Tests only: re-read the URL on the next call. */
+export function resetLookUrl(): void {
+  urlApplied = false;
+}
