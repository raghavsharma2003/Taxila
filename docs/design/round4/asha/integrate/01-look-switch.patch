-export const puppetPoster = (framing: "medium" | "close" = "medium") => `${PUPPET_BASE}rest-${framing}.webp`;
-/** c-front's backdrop cream: the painted layers were cut against it, so the canvas clears to it (no halo). */
-export const PUPPET_CLEAR: [number, number, number] = [251.4 / 255, 229.4 / 255, 188.6 / 255];
-/** The rest-space window shown per framing: [x0, y0, width] in c-front pixels (1024² space). */
-export const PUPPET_VIEW = { medium: [60, 8, 904], close: [140, 70, 744] } as const satisfies Record<string, readonly [number, number, number]>;
+export const puppetPoster = (framing: "medium" | "close" = "medium") => PUPPET_LOOK.poster(framing);
+export const PUPPET_CLEAR: [number, number, number] = PUPPET_LOOK.clear;
+export const PUPPET_VIEW: { medium: PuppetView; close: PuppetView } = PUPPET_LOOK.view;
+/** The host's backdrop under the poster: the look's cream, as CSS. */
+export const puppetHostColor = (look: PuppetLook = PUPPET_LOOK) => `rgb(${look.clear.map((c) => Math.round(c * 255)).join(",")})`;
+
+/**
+ * The poster <img> style for a framing. A 3-element view (r8): the poster spans the view's width from the top. A
+ * 4-element view (lamp1): the full 1024 x 1024 rest frame scaled by min(W / w, H / h) and centred on the region, i.e.
+ * the runtime's fit (rig.js render: sc = min(cw / v[2], ch / v[3])), written in container units of the host (the host
+ * sets container-type: size), so it needs no JS and no resize listener.
+ */
+export function posterStyle(framing: "medium" | "close" = "medium", look: PuppetLook = PUPPET_LOOK): CSSProperties {
+  const v = look.view[framing];
+  if (v.length < 4) return { position: "absolute", left: 0, top: 0, width: "100%", height: "auto", display: "block" };
+  const [x0, y0, w, h] = v;
+  const k = `min(100cqw / ${w}, 100cqh / ${h})`;
+  return {
+    position: "absolute", display: "block", maxWidth: "none",
+    width: `calc(1024 * ${k})`, height: `calc(1024 * ${k})`,
+    left: `calc(50cqw - ${x0 + w / 2} * ${k})`, top: `calc(50cqh - ${y0 + h / 2} * ${k})`,
+  };
+}
