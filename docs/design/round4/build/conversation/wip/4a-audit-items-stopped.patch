@@ -0,0 +1,38 @@
+// round 4 (stream 4A; stream 5's journey audit #5, 2026-10-10): day 2 opened "aaj hum grams aur kilograms se weight compare
+// karenge…" as if new, and Kaksha day 2 asked "Aapne fractions multiply kiye hain?" after a fractions lesson. A topic the
+// child has outcomes on from earlier lessons opens from last time; a new topic opens as before. Pure.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { initLessonState, step, beforeOf } from "../server/director/state.js";
+import { kit, CTX } from "./fixtures/kit.mjs";
+
+const K = kit();
+const start = (history, env = {}) => {
+  const was = process.env.TAXILA_P5_R4CONV;
+  try {
+    if (env.off) process.env.TAXILA_P5_R4CONV = "off"; else delete process.env.TAXILA_P5_R4CONV;
+    return step(initLessonState({ topicId: K.topicId, kit: K, ctx: CTX, seed: 11, now: 0, history }), { event: "start", kit: K, now: 0 });
+  } finally { if (was == null) delete process.env.TAXILA_P5_R4CONV; else process.env.TAXILA_P5_R4CONV = was; }
+};
+
+test("A-05: yesterday's topic opens from yesterday, never 'have you learnt this?'", () => {
+  const sk = K.skills[0];
+  const yesterday = { [sk.id]: ["incorrect", "correct", "correct"] };
+  assert.deepEqual(beforeOf(K, yesterday), { titles: [sk.title], right: 2, answered: 3 });
+  const r = start(yesterday);
+  assert.equal(r.move.kind, "greet");
+  assert.match(r.move.shape, /worked on this before/);
+  assert.ok(r.move.shape.includes(sk.title));
+  assert.match(r.move.shape, /never ask whether they have learnt it, never present it as new/);
+  assert.doesNotMatch(r.move.shape, /one line on today's topic/);
+});
+
+test("a new topic, and R4CONV off: the opening is as before", () => {
+  assert.equal(beforeOf(K, {}), null);
+  const fresh = start({});
+  assert.doesNotMatch(fresh.move.shape, /worked on this before/);
+  assert.equal(fresh.state.before, undefined);
+  const off = start({ [K.skills[0].id]: ["correct"] }, { off: true });
+  assert.doesNotMatch(off.move.shape, /worked on this before/);
+  assert.equal(off.state.before, undefined);
+});
