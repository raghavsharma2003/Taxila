diff --git a/tests/r4-tired-break.test.mjs b/tests/r4-tired-break.test.mjs
new file mode 100644
index 00000000..3f53d15f
--- /dev/null
+++ b/tests/r4-tired-break.test.mjs
@@ -0,0 +1,54 @@
+// round 4 (stream 4A; stream 5's journey audit #6, 2026-10-10): "Bas, ab main thak gayi" got "Theek hai, Riya." and the
+// floor handed back with nothing to answer (the Desk said YOUR TURN). A break is a choice on the buttons: a short rest,
+// keep going, or stop for today; a rest then waits on "Back to the lesson". Behind R4CONV (TAXILA_P5_R4CONV=off is as before). Pure.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { initLessonState, step } from "../server/director/state.js";
+import { findItem } from "../server/director/items.js";
+import { classifyFast, targetFor } from "../server/director/classify.js";
+import { kit, CTX, cls } from "./fixtures/kit.mjs";
+
+const K = kit();
+const fresh = () => initLessonState({ topicId: K.topicId, kit: K, ctx: CTX, seed: 11, now: 0 });
+const turn = (r, c, extra = {}) => step(r.state, { event: "turn", kit: K, cls: c, now: (r.state.turn + 1) * 20_000, ...extra });
+const NE = cls("no_evidence");
+const said = (r, text) => {
+  const fast = classifyFast({ target: targetFor(r.state, K, findItem(r.state, K, r.state.activeItemId)), childText: text, typed: true });
+  return fast.result ?? { outcome: "no_evidence", confidence: 1, source: "model", flags: fast.flags, request: fast.request };
+};
+const withFlag = (v, fn) => { const k = "TAXILA_P5_R4CONV", was = process.env[k]; try { if (v == null) delete process.env[k]; else process.env[k] = v; return fn(); } finally { if (was == null) delete process.env[k]; else process.env[k] = was; } };
+function toPractice() {
+  let r = step(fresh(), { event: "start", kit: K, now: 0 });
+  while (r.state.phase !== "practice" || !r.move.itemId || r.move.itemId.startsWith("fade:")) r = turn(r, NE);
+  return r;
+}
+
+test("A-06: 'Bas, ab main thak gayi' is a choice — rest, keep going or stop for today — never the floor with nothing on it", () => withFlag(undefined, () => {
+  const r = toPractice();
+  const LINE = "Bas, ab main thak gayi";
+  const t = turn(r, said(r, LINE), { text: LINE });
+  assert.equal(t.move.kind, "break");
+  assert.match(t.move.shape, /tired/);
+  assert.deepEqual(t.ui.chips.map((c) => c.id), ["break:rest", "stop:continue", "stop:end"]);
+  assert.equal(t.ui.handover, "choice", "the Desk shows the choice, not YOUR TURN");
+  // a rest waits on "Back to the lesson"; that chip goes straight back in
+  const rest = turn(t, NE, { chipId: "break:rest" });
+  assert.equal(rest.move.kind, "break");
+  assert.deepEqual(rest.ui.chips.map((c) => c.id), ["stop:continue"]);
+  const back = turn(rest, NE, { chipId: "stop:continue" });
+  assert.notEqual(back.move.kind, "break");
+  // stop for today wraps
+  const stop = turn(t, NE, { chipId: "stop:end" });
+  assert.ok(stop.move.kind === "wrap" || stop.state.phase === "done", "stop for today is a wrap");
+  // a plain break ask gets the same choice with the plain shape
+  const b = turn(r, said(r, "break chahiye"), { text: "break chahiye" });
+  assert.match(b.move.shape, /short break/);
+  assert.equal(b.ui.handover, "choice");
+}));
+
+test("R4CONV off: the break is as before", () => withFlag("off", () => {
+  const r = toPractice();
+  const t = turn(r, said(r, "Bas, ab main thak gayi"), { text: "Bas, ab main thak gayi" });
+  assert.equal(t.move.kind, "break");
+  assert.equal(t.ui.chips, undefined);
+}));
