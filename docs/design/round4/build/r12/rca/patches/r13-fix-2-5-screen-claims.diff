+/** "screen par … dekho:", "board pe dekhiye", "look at the screen:": the pointing phrase of a sentence that only LOOKS. */
+const POINTING = /\b(?:(?:screen|board)\s+(?:par|pe|mein|me)\s+|on\s+the\s+(?:screen|board)\s*,?\s*|स्क्रीन\s+पर\s+)((?:[\p{L}\p{N}]+\s+){0,3}?)(?:dekho|dekhiye|dekh\s+lo|dekhte\s+hain|look(?:\s+at\s+(?:it|this))?|देखो)\b\s*/iu;
+const LOOK_AT_SCREEN = /\b(?:look\s+at\s+the\s+(?:screen|board)|(?:screen|board)\s+(?:par|pe)\s+(?:dekho|dekhiye))\b\s*[:,—-]?\s*/iu;
+/**
+ * A sentence that only POINTS at the screen, with the pointing taken out and its content kept ("Screen par seedhi dekho:
+ * 4, 7, 10." → "Seedhi: 4, 7, 10."), or null when it asks the child to act (tap, drag …) or nothing worth saying is left.
+ * r12 RCA failure 5 (owner lesson a95d2ff1 turn 11): deleting the whole sentence took the sequence with it and the child got
+ * "Ab 10 ke baad number bolo." with no 10 before it.
+ */
+export function unpointScreen(sentence) {
+  const s0 = String(sentence ?? "");
+  if (ACT_WORDS.test(s0)) return null;
+  const s = s0.replace(POINTING, (_m, what) => (what ? `${what.trim()}: ` : "")).replace(LOOK_AT_SCREEN, "").replace(/:\s*:/, ":").replace(/^\s*[:,—-]\s*/, "").trim();
+  if (refersToScreen(s) || POINT_AT.test(s) || s.split(/\s+/).filter((w) => /[\p{L}\p{N}]/u.test(w)).length < 2) return null;
+  return s[0].toUpperCase() + s.slice(1);
+}
 
