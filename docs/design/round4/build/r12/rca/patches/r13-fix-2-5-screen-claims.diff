+export function screenProblem(text, ui, module) {
+  const t = String(text ?? "");
+  if (refersToScreen(t)) {
+    const act = ACT_WORDS.test(t);
+    // acting on the screen needs something to act on (and never a board drawn to be watched)
+    if (act && (!screenHasTargets(ui, module) || (watchOnly(module) && !ui?.chips?.length))) return true;
+    // r12 RCA failure 5: LOOKING needs only something to look at — a whiteboard counts; what it shows is checked below
+    if (!act && !screenHasTargets(ui, module) && !ui?.studioSlot?.artifact) return true;
+  }
+  return screenClaimProblem(t, ui, module);
+}
+
+// ── r12 RCA failure 2: a claim about the screen is checked against what is mounted ──
+// Owner lesson a95d2ff1: "Screen par game: left Recursive, right Explicit" (turn 3, no game mounted) and "screen par aloo
+// dekho" / "board par aloo dekho" (turns 23, 25, a maths table on screen) passed, because G-SAY-1 asked only whether
+// there was something to TAP. A sentence that points at the screen or the board must name what is there.
+const POINT_AT = /\b(?:screen|board|whiteboard)\s+(?:par|pe|mein|me)\b|\bon\s+the\s+(?:screen|board)\b|\blook\s+at\s+the\s+(?:screen|board)\b|(?:स्क्रीन|बोर्ड)\s+(?:पर|में)/iu;
+const PLAY_CLAIM = /\b(?:game|games|khel|khelo|khelte|khelenge|activity|play)\b|गेम|खेल/iu;
+const CLAIM_STOP = new Set("screen board whiteboard dekho dekhiye dekhte dekh look there here yahan wahan abhi tumhe tumhara aapko aapka dikh raha rahi kaunsa kaunsi kitne kitna batao bataiye socho phir pehle aage left right upar neeche game khel".split(" "));
+const stem = (w) => w.toLowerCase().normalize("NFKC").slice(0, 5);
+/** The words a mounted piece shows: a whiteboard's texts, the rung's texts and facts, the chips' labels. */
+export function stageWords(ui, module) {
+  const out = new Set();
+  const add = (x) => { for (const w of String(x ?? "").split(/[^\p{L}\p{N}]+/u)) if (w.length >= 2) out.add(stem(w)); };
+  for (const o of ui?.studioSlot?.artifact?.script?.ops ?? []) if (o?.text) add(o.text);
+  for (const v of Object.values(ui?.studioSlot?.artifact?.script?.facts?.onScreen ?? {})) add(v);
+  for (const o of module?.params?.script?.ops ?? []) if (o?.text) add(o.text);
+  for (const v of Object.values(module?.params?.script?.facts?.onScreen ?? {})) add(v);
+  for (const c of ui?.chips ?? []) add(c?.label);
+  return out;
+}
+const playMounted = (ui, module) => ["play", "stagecraft"].includes(ui?.studioSlot?.artifact?.kind) || (!!module?.id && module.engine !== "explainer@1" && !!module.engine);
+/** true when a sentence points at the screen / board and claims what is not there: a game with no play piece up, or
+ * content none of whose words the mounted piece shows. PURE. */
+export function screenClaimProblem(text, ui, module) {
+  const sentences = String(text ?? "").match(/[^.!?।]+[.!?।]*/g) ?? [];
+  const pointing = sentences.filter((x) => POINT_AT.test(x));
+  if (!pointing.length) return false;
+  const words = stageWords(ui, module);
+  for (const x of pointing) {
+    if (PLAY_CLAIM.test(x) && !playMounted(ui, module)) return true;
+    const content = (x.match(/[\p{L}\p{N}]+/gu) ?? []).filter((w) => w.length >= 3 && !CLAIM_STOP.has(w.toLowerCase()) && !/^[A-Z][a-z]+$/.test(w) || /^\d+$/.test(w));
+    if (!content.length) continue;
+    if (!words.size || !content.some((w) => words.has(stem(w)))) return true;
+  }
+  return false;
+}
