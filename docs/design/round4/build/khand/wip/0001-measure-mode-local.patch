+      }
+      if (p.goal === "make") c.push({ id: "done", label: "Check", kind: "primary", you: true, group: "go", onPress: () => act({ kind: "check" }) });
+      else c.push({ id: "say", label: s.named === null ? "Say how many" : "Say again", kind: "primary", you: true, group: "go", onPress: () => { pad = true; deps.changed(); } });
