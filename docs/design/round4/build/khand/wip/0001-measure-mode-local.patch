+  const act = (a: NazariyaAct) => { const r = ctl.dispatch(a as PlayActBody as never); deps.changed(); return r; };
+
+  function layout(w: number, h: number): void {
+    cw = clamp(Math.floor((w - 24 - (K - 1) * gap) / K), 64, 120);
+    ch = clamp(Math.floor((h - 24 - (pans - 1) * 40) / pans) - 28, 88, 140);
+    ox = Math.round((w - (K * cw + (K - 1) * gap)) / 2); oy = 34; rowH = ch + 40;
+  }
+  /** counts on a pan: the given load, the right pan, or the child's own pieces */
+  const countsOn = (pan: number, s: NzState): number[] | null => {
+    if (p.goal === "total") return p.given!;
+    if (p.goal === "compare") return s.predicted === null ? null : pan === 0 ? p.given! : p.other!;
