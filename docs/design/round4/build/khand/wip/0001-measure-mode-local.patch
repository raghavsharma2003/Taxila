+  if (p.goal === "total") f.load = textOf(p, p.given!);
+  if (p.goal === "make" || p.goal === "split") f.target = `${p.target} ${U.small}`;
+  if (p.goal === "compare") { f.left = textOf(p, p.given!); f.right = textOf(p, p.other!); if (s.predicted !== null) f.picked = s.predicted ? "left" : "right"; }
