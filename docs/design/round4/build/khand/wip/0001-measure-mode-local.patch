+        return c;
+      }
+      if (p.goal === "compare") {
+        c.push({ id: "pick-left", label: "Left side", kind: "secondary", group: "predict", onPress: () => act({ kind: "predict", same: true }) });
+        c.push({ id: "pick-right", label: "Right side", kind: "secondary", group: "predict", onPress: () => act({ kind: "predict", same: false }) });
+        return c;
+      }
+      if (open) {
+        c.push({ id: "tool-build", label: "Build", kind: "choice", group: "tools", aria: `Build${tool === "build" ? " (on)" : ""}`, onPress: () => { tool = "build"; deps.changed(); } });
+        c.push({ id: "tool-remove", label: "Break", kind: "choice", group: "tools", aria: `Break${tool === "remove" ? " (on)" : ""}`, onPress: () => { tool = "remove"; deps.changed(); } });
