+  if (s.named !== null) f.said = s.named;
+  if (s.done) f.done = "yes";
+  return f;
+}
+function board(level: PlayLevel<MeasureParams>, s: NzState) {
+  const p = level.params, U = UNITS[p.unit];
+  const ask = p.goal === "total" ? `${textOf(p, p.given!)} = ? ${U.small}` : p.goal === "make" ? `make ${p.target} ${U.small}` : p.goal === "split" ? `${p.target} ${U.small} = ? whole ${U.big}` : `${textOf(p, p.given!)} | ${textOf(p, p.other!)}: which ${moreWord(p.unit)}?`;
+  const lines = [ask];
+  if (p.goal === "make") lines.push(`yours: ${valueOf(p, countsOf(p, s.h))} ${U.small}`);
+  if (s.named !== null) lines.push(`said: ${s.named}`);
+  return { title: "Measure", lines };
+}
+
+export const measureLogic = makeLogic<MeasureParams>({ mode: "measure", malRules: MEASURE_MAL, validate, check, name, predict, gate, build, solve, shortcut, malActs, generate, facts, board });
+export const measureHelpers = { measurePlot, countsOf, valueOf, textOf, keyOf, malValue, UNITS };
