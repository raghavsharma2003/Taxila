+      const c = unit === "half" ? [big, rnd() < 0.3 ? 1 : 0] : counts(big);
+      push({ goal, unit, given: c }, `total:${c.join(".")}`, 0.2 + 0.1 * c.filter(Boolean).length);
+    } else if (goal === "make" || goal === "split") {
+      const c = counts(1 + Math.floor(rnd() * 4)), T = valueOf({ unit }, c);
+      if (T > 9999 || T < S[0]) continue;
+      push({ goal, unit, target: T }, `${goal}:${T}`, goal === "make" ? 0.25 + 0.05 * c.filter(Boolean).length : 0.35);
+    } else {
