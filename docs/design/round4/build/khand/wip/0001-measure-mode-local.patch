+  return level.params.goal === "compare" ? [{ kind: "predict", same: v === 1 }] : [{ kind: "name", n: v }];
+}
+
+function generate(req: GenRequest): Candidate<MeasureParams>[] {
+  const g = req.grammar as { unit?: MeasureUnit };
+  const unit: MeasureUnit = g.unit && g.unit in UNITS ? g.unit : "g";
