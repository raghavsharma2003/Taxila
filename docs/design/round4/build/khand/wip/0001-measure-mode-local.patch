--- /dev/null
+++ b/src/play/families/nazariya/measure.logic.ts
@@ -0,0 +1,292 @@
+// Nazariya · measure (weight, capacity, length: c4-maths-ch08, c5-maths-ch08, c5-maths-ch05, c4-maths-ch06, c3-maths-ch11).
+// Quantities are built from base-ten unit blocks whose VOLUME is their size in the small unit: a 1 kg block is a
+// 10 × 10 × 10 cube of 1 g voxels, 100 g a 10 × 10 flat, 10 g a rod of ten, 1 g one voxel (likewise l / ml, km / m;
+// for m / cm the metre is the 10 × 10 flat of 100 cm; half litres are two-voxel dominoes). So the number of small units
+// in the world is literally the number of voxels, and every count below is a count of voxels, never a table.
+//   total   — a load is given (locked): say how many small units it is (2 kg 50 g → 2050).
+//   make    — a target in the small unit is given (2050 g): tap the bays to lay it, then check.
+//   split   — a target in the small unit is given (4250 g): say how many WHOLE big units it holds (4).
+//   compare — two loads written in different units (1 kg | 900 g): say which pan is heavier, then the blocks appear.
+// Mal-rules (the number a belief says): ratio-small (1 kg = 100 g: the big unit taken ten times too small) · mixed-concat
+// (2 kg 50 g read as 250: the parts written side by side) · number-only (the pan with the bigger NUMBER is heavier).
+import type { Candidate, Facts, GenRequest, Moment, NazariyaAct, PlayLevel } from "../../../../shared/play.ts";
+import { mulberry32 } from "../../core/rng.ts";
+import { commit, lvl, makeLogic, mom, zeros, type Applied, type NzState, type Plot } from "./grid.ts";
+
+export type MeasureUnit = "g" | "ml" | "m" | "cm" | "half";
+export type MeasureGoal = "total" | "make" | "split" | "compare";
+/** Piece sizes in the small unit, biggest first, and the words for each piece and for the two units. */
+export const UNITS: Record<MeasureUnit, { sizes: number[]; piece: string[]; big: string; small: string }> = {
+  g: { sizes: [1000, 100, 10, 1], piece: ["1 kg", "100 g", "10 g", "1 g"], big: "kg", small: "g" },
+  ml: { sizes: [1000, 100, 10, 1], piece: ["1 l", "100 ml", "10 ml", "1 ml"], big: "l", small: "ml" },
+  m: { sizes: [1000, 100, 10, 1], piece: ["1 km", "100 m", "10 m", "1 m"], big: "km", small: "m" },
+  cm: { sizes: [100, 10, 1], piece: ["1 m", "10 cm", "1 cm"], big: "m", small: "cm" },
+  half: { sizes: [2, 1], piece: ["1 l", "½ l"], big: "l", small: "half litres" },
+};
+/** What "more" means for the unit's quantity (compare's question). */
+export const moreWord = (u: MeasureUnit) => (u === "g" ? "heavier" : u === "ml" || u === "half" ? "holds more" : "longer");
+export const MEASURE_MAL = ["ratio-small", "mixed-concat", "number-only"] as const;
+const GAP = 1, STACK_CAP = 19;
+
+/** One bay: where piece kind k lives and how its pieces are laid (by size). */
+export interface Bay { k: number; x0: number; w: number; d: number; cap: number }
+export interface MeasureParams extends Plot {
+  goal: MeasureGoal; unit: MeasureUnit;
+  /** counts per piece kind of the given load (total; compare's left pan) */
+  given?: number[];
+  /** compare's right pan, counts per piece kind */
+  other?: number[];
+  /** make / split: the target in the small unit */
+  target?: number;
+  /** the child's bays (make / split), or the given loads' bays (total / compare) */
+  bays: Bay[];
+}
+
+const footprint = (size: number): [number, number] => (size >= 100 ? [10, 10] : size === 10 ? [10, 10] : size === 2 ? [2, 10] : [10, 1]);
+const capsFor = (sizes: number[], bigCap: number) => sizes.map((s, k) => (k === 0 && s === 1000 ? bigCap : STACK_CAP));
+/** Bays left to right from x0: a cube kind gets one footprint per piece; every other kind one footprint, stacked. */
+function baysFrom(sizes: number[], caps: number[], x0: number): { bays: Bay[]; w: number } {
+  const bays: Bay[] = []; let x = x0;
+  sizes.forEach((s, k) => {
+    const [fw, fd] = footprint(s), w = s === 1000 ? caps[k] * (fw + GAP) - GAP : fw;
+    bays.push({ k, x0: x, w, d: fd, cap: caps[k] }); x += w + GAP + 1;
+  });
+  return { bays, w: x - x0 - GAP - 1 };
+}
+/** Lay `count` pieces of `size` in a bay (canonical: rows / cells filled first, then the next layer). */
+function lay(h: number[], W: number, b: Bay, size: number, count: number): void {
+  if (size === 1000) { for (let c = 0; c < count; c++) for (let z = 0; z < 10; z++) for (let x = 0; x < 10; x++) h[z * W + b.x0 + c * 11 + x] = 10; return; }
+  if (size === 100) { for (let z = 0; z < 10; z++) for (let x = 0; x < 10; x++) h[z * W + b.x0 + x] = count; return; }
+  if (size === 10) { for (let i = 0; i < count; i++) { const z = i % 10; for (let x = 0; x < 10; x++) h[z * W + b.x0 + x]++; } return; }
+  if (size === 2) { for (let i = 0; i < count; i++) { const z = i % 10; h[z * W + b.x0]++; h[z * W + b.x0 + 1]++; } return; }
+  for (let i = 0; i < count; i++) h[b.x0 + (i % 10)]++;
+}
+const cellsOf = (W: number, b: Bay): number[] => { const out: number[] = []; for (let z = 0; z < b.d; z++) for (let x = 0; x < b.w; x++) out.push(z * W + b.x0 + x); return out; };
+
+/** The plot for (unit, goal, loads / target): rebuilt from these alone, so a device can never move the scenery. */
+export function measurePlot(r: { goal: MeasureGoal; unit: MeasureUnit; given?: number[]; other?: number[]; target?: number }): MeasureParams | null {
+  const U = UNITS[r.unit]; if (!U) return null;
+  const S = U.sizes, K = S.length;
+  const okCounts = (c: unknown): c is number[] => Array.isArray(c) && c.length === K && c.every((v) => Number.isInteger(v) && v >= 0 && v <= 9);
+  if (r.goal === "total" || r.goal === "compare") {
+    if (!okCounts(r.given) || (r.goal === "compare" && !okCounts(r.other))) return null;
+    const bigCap = Math.max(1, r.given[0], r.other?.[0] ?? 0);
+    const left = baysFrom(S, capsFor(S, bigCap), 0);
+    const right = r.goal === "compare" ? baysFrom(S, capsFor(S, bigCap), left.w + 3) : null;
+    const W = right ? left.w + 3 + right.w : left.w, D = 10;
+    const base = zeros(W * D);
+    // total: the load stands from the start; compare: the pans are empty until the child has said which is heavier
+    if (r.goal === "total") left.bays.forEach((b) => lay(base, W, b, S[b.k], r.given![b.k]));
+    return { w: W, d: D, hmax: S[0] === 1000 ? 10 : STACK_CAP, base, lock: Array(W * D).fill(1), goal: r.goal, unit: r.unit, given: [...r.given], ...(r.other ? { other: [...r.other] } : {}), bays: [...left.bays, ...(right?.bays ?? [])] };
+  }
+  const T = Number(r.target);
+  if (!Number.isInteger(T) || T < 1 || T > 9999) return null;
+  const bigCap = Math.min(9, Math.floor(T / S[0]) + 1);
+  const { bays, w } = baysFrom(S, capsFor(S, bigCap), 0);
+  const W = w, D = 10, lock = Array(W * D).fill(1);
+  for (const b of bays) for (const i of cellsOf(W, b)) lock[i] = 0;
+  return { w: W, d: D, hmax: Math.max(S[0] === 1000 ? 10 : 0, STACK_CAP), base: zeros(W * D), lock, goal: r.goal, unit: r.unit, target: T, bays };
+}
+
+/** Counts per piece kind in the child's bays (make / split), read off the voxels. */
+export function countsOf(p: MeasureParams, h: readonly number[]): number[] {
+  const S = UNITS[p.unit].sizes, out = S.map(() => 0);
+  for (const b of p.bays) { let v = 0; for (const i of cellsOf(p.w, b)) v += h[i]; out[b.k] += Math.round(v / S[b.k]); }
+  return out;
+}
+/** The value of a load in the small unit: its voxels (= Σ count × size). */
+export const valueOf = (p: { unit: MeasureUnit }, c: readonly number[]) => c.reduce((a, n, k) => a + n * UNITS[p.unit].sizes[k], 0);
+/** A load as words: "2 kg 50 g" (big part, then the rest in the small unit). */
+export function textOf(p: { unit: MeasureUnit }, c: readonly number[]): string {
+  const U = UNITS[p.unit], big = c[0], rest = valueOf(p, c) - big * U.sizes[0];
+  if (p.unit === "half") return `${big} l${rest ? " and a half" : ""}`;
+  return [big ? `${big} ${U.big}` : "", rest || !big ? `${rest} ${U.small}` : ""].filter(Boolean).join(" ");
+}
+/** The answer: total → the value; split → whole big units; compare → left heavier? (1 / 0). */
+export function keyOf(p: MeasureParams): number {
+  const S = UNITS[p.unit].sizes;
+  if (p.goal === "total") return valueOf(p, p.given!);
+  if (p.goal === "split") return Math.floor(p.target! / S[0]);
+  if (p.goal === "compare") return valueOf(p, p.given!) > valueOf(p, p.other!) ? 1 : 0;
+  return p.target!;
+}
+/** The number (or pan) each belief gives here, or null where it says nothing different. */
+export function malValue(p: MeasureParams, mal: string): number | null {
+  const S = UNITS[p.unit].sizes, small = S[0] / 10;
+  if (p.unit === "half") return null;
+  if (p.goal === "total") {
+    const big = p.given![0], rest = valueOf(p, p.given!) - big * S[0];
+    if (mal === "ratio-small") return big ? big * small + rest : null;
+    if (mal === "mixed-concat") return big && rest ? Number(`${big}${rest}`) : null;
+  }
+  if (p.goal === "split" && mal === "ratio-small") return Math.floor(p.target! / small);
+  if (p.goal === "compare" && mal === "number-only") {
+    // the number written on each pan: the left load in its big unit, the right in the small unit
+    const l = p.given![0], r = valueOf(p, p.other!);
+    return l === r ? null : l > r ? 1 : 0;
+  }
+  return null;
+}
+/** The beliefs this level tells apart: a value that differs from the key and from every other belief's. */
+function malsApart(level: PlayLevel<MeasureParams>): string[] {
+  const p = level.params, key = keyOf(p), vals = MEASURE_MAL.map((m) => malValue(p, m));
+  return MEASURE_MAL.filter((m, i) => m in level.mal && vals[i] !== null && vals[i] !== key && (vals[i] as number) <= 9999 && vals.filter((v) => v === vals[i]).length === 1);
+}
+
+function validate(raw: unknown): MeasureParams | null {
+  const r = raw as Partial<MeasureParams> | null;
+  if (!r || typeof r !== "object" || !["total", "make", "split", "compare"].includes(String(r.goal)) || !(String(r.unit) in UNITS)) return null;
+  const p = measurePlot({ goal: r.goal as MeasureGoal, unit: r.unit as MeasureUnit, given: r.given, other: r.other, target: r.target });
+  if (!p) return null;
+  // the level's plot must be exactly the one these numbers make
+  const same = (a: unknown, b: unknown[]) => Array.isArray(a) && a.length === b.length && a.every((v, i) => v === b[i]);
+  if (r.w !== p.w || r.d !== p.d || r.hmax !== p.hmax || !same(r.base, p.base) || !same(r.lock, p.lock)) return null;
+  if (p.goal === "total" && (valueOf(p, p.given!) < 1 || valueOf(p, p.given!) > 9999)) return null;
+  if (p.goal === "split" && keyOf(p) < 1) return null;
+  if (p.goal === "compare" && valueOf(p, p.given!) === valueOf(p, p.other!)) return null;
+  return p;
+}
+
+/** make / split: a tap in a bay adds (place) or takes (remove) ONE piece of that bay's size. Drags are not pieces. */
+function build(level: PlayLevel<MeasureParams>, s: NzState, act: NazariyaAct): number[] | string {
+  const p = level.params;
+  if (p.goal === "total" || p.goal === "compare") return "locked";
+  if (act.kind === "layer" || act.kind === "clear") return "tap_a_bay";
+  const a = act as { x?: number; z?: number }, x = Number(a.x), z = Number(a.z);
+  const b = p.bays.find((y) => x >= y.x0 && x < y.x0 + y.w && z >= 0 && z < y.d);
+  if (!b) return "locked";
+  const c = countsOf(p, s.h);
+  if (act.kind === "place") { if (c[b.k] >= b.cap) return "bay_full"; c[b.k]++; }
+  else { if (c[b.k] <= 0) return "empty"; c[b.k]--; }
+  const h = zeros(p.w * p.d), S = UNITS[p.unit].sizes;
+  for (const y of p.bays) lay(h, p.w, y, S[y.k], c[y.k]);
+  return h;
+}
+/** split at fade ≥ 2: the number is said before anything is laid (the live total would read it off) */
+function gate(level: PlayLevel<MeasureParams>, s: NzState, act: NazariyaAct): string | null {
+  const isBuild = act.kind === "place" || act.kind === "remove" || act.kind === "layer" || act.kind === "clear";
+  return isBuild && level.params.goal === "split" && level.fade >= 2 && s.named === null ? "say_whole_first" : null;
+}
+
+function check(level: PlayLevel<MeasureParams>, s: NzState, seq: number): Applied {
+  const p = level.params, bumped = { ...s, acts: s.acts + 1 };
+  if (p.goal !== "make") return { state: bumped, moments: [mom("law_refused", seq, { why: p.goal === "compare" ? "pick_a_pan" : "say_how_many" })], refused: "say_first" };
+  const c = countsOf(p, s.h), v = valueOf(p, c), T = p.target!;
+  if (v === 0) return { state: bumped, moments: [mom("law_refused", seq, { why: "build_first" })], refused: "build_first" };
+  const facts: Facts = { made: v, target: T, unit: UNITS[p.unit].small };
+  if (v === T) return { state: commit(s, { ...s, done: true }), moments: [mom("solved", seq, { ...facts, load: textOf(p, c) })] };
+  const near = UNITS[p.unit].sizes.includes(Math.abs(v - T));
+  return { state: bumped, moments: [mom(near ? "near_miss" : "law_refused", seq, { ...facts, why: v > T ? "too_heavy" : "too_light" })], refused: "mismatch" };
+}
+
+function name(level: PlayLevel<MeasureParams>, s: NzState, n: number, seq: number): Applied {
+  const p = level.params, bumped = { ...s, acts: s.acts + 1 };
+  if (p.goal !== "total" && p.goal !== "split") return { state: bumped, moments: [], refused: "no_name_here" };
+  const key = keyOf(p), U = UNITS[p.unit], next = commit(s, { ...s, named: n });
+  const shown: Facts = { said: n, unit: p.goal === "split" ? U.big : U.small, ...(p.goal === "total" ? { load: textOf(p, p.given!) } : { target: `${p.target} ${U.small}` }) };
+  if (n === key) return { state: { ...next, done: true }, moments: [mom("solved", seq, shown)] };
+  const mal = malsApart(level).find((m) => malValue(p, m) === n);
+  if (mal) return { state: next, moments: [mom("misconception_consequence", seq, shown, mal)], refused: "wrong_count" };
+  // one piece off (total), or one whole unit off (split): a slip
+  const slip = p.goal === "total" ? U.sizes.includes(Math.abs(n - key)) : Math.abs(n - key) === 1;
+  return { state: next, moments: [mom(slip ? "near_miss" : "law_refused", seq, { ...shown, why: "count_again" })], refused: "wrong_count" };
+}
