+// Nazariya · measure, drawn flat: Khand's BOARD TWIN for the unit-block mode (the plot is too wide to draw cell by cell
+// on a phone). One card per bay: the piece's name ("1 kg", "100 g"), a small drawing of its shape (cube, flat, rod,
+// one), and how many are there. A tap on a card adds one piece (Break takes one off); compare shows the two written
+// loads until the child picks a side, then the pieces. Same goal line and control ids as the 3D engine.
+import type { Moment, NazariyaAct, PlayActBody } from "../../../../shared/play.ts";
+import type { PointerKind, ViewApi } from "../../core/stage.ts";
+import { clamp, type ControlSpec, type FamilyView, type MakeView, type Readout, type ViewDeps } from "../../core/viewkit.ts";
+import { goalOf } from "../../engines/khand/words.ts";
+import type { NzState } from "./grid.ts";
+import { UNITS, countsOf, textOf, valueOf, type MeasureParams } from "./measure.logic.ts";
+
+export const makeMeasureView: MakeView = (api: ViewApi, depsIn: ViewDeps) => {
+  const deps = depsIn as unknown as ViewDeps<MeasureParams, NzState, NazariyaAct>;
+  const { level, ctl, lang } = deps;
+  const p = level.params, U = UNITS[p.unit], K = U.sizes.length, fade = level.fade;
+  const pans = p.goal === "compare" ? 2 : 1, open = p.goal === "make" || p.goal === "split";
+  let tool: "build" | "remove" = "build", pad = p.goal === "total" || (p.goal === "split" && fade >= 2), num = 0, reveal = false;
