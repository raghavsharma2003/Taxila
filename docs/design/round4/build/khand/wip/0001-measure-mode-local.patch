+    const params = measurePlot(r);
+    if (params && validate(params)) out.push({ signature: sig, difficulty: Math.min(1, diff), level: lvl(req, "measure", goal, params, sig) });
+  };
+  // half the loads skip the place right below the big unit (2 kg 50 g, 1 m 5 cm): there the parts written side by side
+  // (250, 15) are not the value, so the mixed-concat belief shows (the kit's own examples have this shape)
+  const counts = (big: number) => { const skip = rnd() < 0.5; return S.map((_, k) => (k === 0 ? big : (k === 1 && skip) || rnd() < 0.3 ? 0 : 1 + Math.floor(rnd() * 9))); };
