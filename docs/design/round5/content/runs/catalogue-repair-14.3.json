  {
   "topicId": "c4-english-ch02-t01",
   "line": "L6",
   "said": "A good retelling keeps the events in order: first, next, then, and at last.",
   "before": "Gauri missin → search → bell / → found → home",
   "after": "Gauri missing → search → bell / → found → home"
  },
  {
   "topicId": "c4-evs-ch06-t01",
   "line": "L7",
   "said": "Aarav can play after school, do homework before dinner, turn screens off by 7:30 and sleep by 8:30.",
   "before": "play after  / homewo before / screen off 7: / sleep 8:30",
   "after": "play after  / homework before / screen off 7: / sleep 8:30"
  },
  {
   "topicId": "c4-hindi-ch01-t01",
   "line": "L6",
   "said": "आकार, तैयार और सुकुमार—इनका अंत संसार से तुक मिलाता है।",
   "before": "आकार = आकार | तैयार = संसार | सुकुमा = संसार | पसार = संसार",
   "after": "आकार = आकार | तैयार = संसार | सुकुमार = संसार | पसार = संसार"
  },
  {
   "topicId": "c4-hindi-ch01-t01",
   "line": "L7",
   "said": "एक सही वर्तनी भी याद रखें: चिड़िया और उड़ी में नीचे बिंदु वाला ड़ आता है।",
   "before": "चि ＋ ड़ि ＋ या = चिड़िय | उ ＋ ड़ी = उड़ी",
   "after": "चि ＋ ड़ि ＋ या = चिड़िया | उ ＋ ड़ी = उड़ी"
  },
  {
   "topicId": "c4-hindi-ch02-t01",
   "line": "L9",
   "said": "गिलहरी की बड़ी ई छोटी इ बनती है और ‘याँ’ जुड़कर गिलहरियाँ बनता है।",
   "before": "गिलहरी → गिलहरि",
   "after": "गिलहरी → गिलहरियाँ"
  },
  {
   "topicId": "c4-hindi-ch08-t01",
   "line": "L4",
   "said": "इन परंपराओं को याद रखो: पूकलम, नावों की दौड़ और ओणसद्या।",
   "before": "पूकलम → नावों  → ओणसद्य",
   "after": "पूकलम → नावों  → ओणसद्या"
  },
  {
   "topicId": "c4-hindi-ch12-t01",
   "line": "L5",
   "said": "तेनाली ने कहा कि उसके बालों पर पाँच हज़ार अशर्फ़ियाँ उधार हैं। राजा ने उसे पाँच हज़ार अशर्फ़ियाँ दिलवा दीं।",
   "before": "5000 अशर्फ़ | राजा → 5000 अशर्फ़",
   "after": "5000 अशर्फ़ियाँ | राजा → 5000 अशर्फ़ियाँ"
  },
  {
   "topicId": "c4-maths-ch01-t01",
   "line": "L5",
   "said": "For edges, count four around the top, four around the bottom, and four standing up. That makes twelve.",
   "before": "top = 4 / bottom = 4 / standi = 4 | edges = 12",
   "after": "top = 4 / bottom = 4 / standing = 4 | edges = 12"
  },
  {
   "topicId": "c4-maths-ch04-t02",
   "line": "L3",
   "said": "Compare thousands first, then hundreds, tens, and ones.",
   "before": "thousa → hundre → tens → ones",
   "after": "thousand → hundred → tens → ones"
  },
  {
   "topicId": "c4-maths-ch04-t03",
   "line": "L6",
   "said": "To round to the nearest thousand, look at the hundreds digit. To round to the nearest hundred, look at the tens digit.",
   "before": "hundre → thousa | tens → hundre",
   "after": "hundred → thousand | tens → hundred"
  },
  {
   "topicId": "c4-maths-ch04-t03",
   "line": "L7",
   "said": "MYTH: round in steps, like 1450 to 1500 and then 2000. NOT TRUE: rounding an already-rounded number can give the wrong a",
   "before": "1450 → 1500 | 1500 → 2000 | origin → answer",
   "after": "1450 → 1500 | 1500 → 2000 | original → answer"
  },
  {
   "topicId": "c4-maths-ch06-t01",
   "line": "L5",
   "said": "One metre equals 100 centimetres, so 2 metres equals 200 centimetres.",
   "before": "1 metre = 100 centim | 2 metres = 200 centim",
   "after": "1 metre = 100 centimetre | 2 metres = 200 centimetre"
  },
  {
   "topicId": "c4-maths-ch06-t01",
   "line": "L6",
   "said": "Do not join the digits: 1 metre 5 centimetres is 105 centimetres.",
   "before": "1 metre 5 centim | 1 metre 5 centim = 105 centim",
   "after": "1 metre 5 centimetre | 1 metre 5 centimetre = 105 centimetre"
  },
  {
   "topicId": "c4-maths-ch07-t01",
   "line": "L2",
   "said": "Start at the right: ones, then tens, hundreds, and thousands.",
   "before": "thousa | hundre | tens | ones",
   "after": "thousand | hundred | tens | ones"
  },
  {
   "topicId": "c4-maths-ch07-t02",
   "line": "L6",
   "said": "An estimate uses rounded numbers, so it need not equal the exact answer.",
   "before": "estima ≠ exact ",
   "after": "estimate ≠ exact "
  },
  {
   "topicId": "c4-maths-ch07-t02",
   "line": "L8",
   "said": "When an estimate is right at the money limit, calculate the exact total before deciding.",
   "before": "estima = money  | exact  = calcul",
   "after": "estimate = money  | exact  = calculate"
  },
  {
   "topicId": "c4-maths-ch08-t01",
   "line": "L3",
   "said": "Here is the key fact: 1 kilogram is 1000 grams.",
   "before": "1 kilogr = 1000 grams",
   "after": "1 kilogram = 1000 grams"
  },
  {
   "topicId": "c4-maths-ch08-t01",
   "line": "L5",
   "said": "For example, change 1 kilogram 300 grams into grams.",
   "before": "1 kilogr 300 grams | ? grams",
   "after": "1 kilogram 300 grams | ? grams"
  },
  {
   "topicId": "c4-maths-ch08-t02",
   "line": "L3",
   "said": "Before comparing, change both amounts to the same unit. So 1 litre is more than 500 millilitres.",
   "before": "1 litre = 1000 millil | 500 millil",
   "after": "1 litre = 1000 millilitre | 500 millilitre"
  },
  {
   "topicId": "c4-maths-ch08-t02",
   "line": "L7",
   "said": "To find how many glasses fill a jug, count how many times the glass amount fits. Four 250 millilitre glasses make 1000 m",
   "before": "4 × 250 millil = 1000 millil | 1000 millil = 1 litre",
   "after": "4 × 250 millilitre = 1000 millilitre | 1000 millilitre = 1 litre"
  }
 ],
