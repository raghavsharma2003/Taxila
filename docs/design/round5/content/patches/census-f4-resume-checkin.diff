diff -ruN a/tests/r5-census-resume-checkin.test.mjs b/tests/r5-census-resume-checkin.test.mjs
--- a/tests/r5-census-resume-checkin.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/r5-census-resume-checkin.test.mjs	2026-10-21 15:31:54.692300541 +0000
@@ -0,0 +1,34 @@
+// census 2026-10-21 F4 P2 (dad0c9db t25-27): after a safeguard the resume turn asked a rule never taught instead of the
+// carry-on / stop offer: the resume plan carried no `checkin`, so brain/say.js never ran checkInProblems on its words,
+// and a model failure fell back to the item's question. Safety lane patch (main applies it). Pure.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { initLessonState, step } from "../server/director/state.js";
+import { checkInProblems, fallbackReply } from "../server/brain/say.js";
+import { findItem } from "../server/director/items.js";
+import { kit as mk, CTX, cls } from "./fixtures/kit.mjs";
+
+const kit = mk();
+const turn = (r, c, extra = {}) => step(r.state, { event: "turn", kit, cls: c, text: "x", now: 10_000 * (r.state.turn + 1), ...extra });
+
+test("F4: the resume after a safeguard is a check-in: a lesson question in it is caught, stopping must be offered, and its fixed line is the offer", () => {
+  let r = step(initLessonState({ topicId: kit.topicId, kit, ctx: CTX, seed: 7, now: 0 }), { event: "start", kit, now: 0 });
+  for (let i = 0; i < 3 && !r.state.activeItemId; i++) r = turn(r, cls("no_evidence"));
+  r = turn(r, cls("no_evidence", { flags: { distress: true, distressKind: "self_harm" } }));
+  assert.equal(r.move.kind, "safeguard");
+  for (let i = 0; i < 4 && r.move.kind === "safeguard"; i++) r = turn(r, cls("no_evidence"));
+  assert.equal(r.move.kind, "repair", "the resume offer");
+  assert.equal(r.move.checkin, "resume");
+  const item = r.state.activeItemId ? findItem(r.state, kit, r.state.activeItemId) : null;
+  assert.deepEqual(checkInProblems("Kya hum aage chalein ya aaj ke liye rukein?", { kind: "resume", active: item }), []);
+  assert.ok(checkInProblems("Achha, ab batao 3 + 4 kitna hota hai?", { kind: "resume", active: item }).includes("hold"));
+  assert.ok(checkInProblems("Chalo aage badhte hain.", { kind: "resume", active: item }).includes("nostop"));
+  const line = fallbackReply(r.state, item);
+  assert.match(line, /rukein|stop for today/);
+  assert.doesNotMatch(line, /\?.*\?/);
+  if (item) assert.ok(!line.includes(item.prompt_en ?? "@@"), "never the item's question");
+  // and the child's carry-on goes back to the lesson as before
+  const back = turn(r, cls("no_evidence"), { chipId: "safe:continue" });
+  assert.notEqual(back.move.kind, "safeguard");
+  assert.equal(back.move.checkin, undefined);
+});
